# Copy into secret storage outside Git. Do not use this sample as live settings.
ENV=production
DJANGO_DEBUG=0
ALLOW_DEV_AUTH=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DATABASE_URL=
HYHQ_CLOUD_ENV_ID=
HYHQ_CLOUD_ROLE=combined
# Enable only after checking platform proxy behavior and closing public ingress.
HYHQ_CLOUD_PRIVATE_INGRESS_CONFIRMED=0
HYHQ_CLOUD_TRUST_PROXY_HTTPS=0
HYHQ_CLOUD_MOUNT_ROOT=/mnt/hyhq
HYHQ_MEDIA_ROOT=/mnt/hyhq/private
HYHQ_MODEL_ROOT=/mnt/hyhq/models
HYHQ_ASSESSMENT_MODEL_ROOT=/mnt/hyhq/models
# One local lock shared by both inference workers in THIS container.
HYHQ_RECOGNITION_LOCK_PATH=/tmp/hyhq-runtime/inference.lock
HYHQ_CLOUD_STATE_PATH=/tmp/hyhq-runtime/state.json
WECHAT_APP_ID=
WECHAT_APP_SECRET=
LLM_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
QWEATHER_ENABLED=0
QWEATHER_API_KEY=
QWEATHER_API_HOST=
# Leave connectors off until the project-wide ledger/budget split is approved.
QWEATHER_MONTHLY_LIMIT=1
COMMUNITY_ENABLED=0
QWEATHER_FORECAST_ENABLED=0
QWEATHER_FORECAST_ENTITLEMENT_CONFIRMED=0
WEATHER_SUBSCRIPTIONS_ENABLED=0
WEATHER_SUBSCRIPTIONS_CAPABILITY_CONFIRMED=0
