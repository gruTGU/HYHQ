# 实际配置保存在 .private/local.env；此文件只用于说明。
HOST=127.0.0.1
PORT=8787
HYHQ_SESSION_SECRET=
HYHQ_INFERENCE_ENABLED=false
HYHQ_MODEL_ROOT=
HYHQ_LLM_ENABLED=false
DEEPSEEK_API_KEY=
HYHQ_LLM_DAILY_LIMIT=5
HYHQ_LLM_GLOBAL_ATTEMPTS=30
HYHQ_LLM_GLOBAL_TOKENS=60000
HYHQ_QWEATHER_ENABLED=false
QWEATHER_API_KEY=
QWEATHER_API_HOST=
HYHQ_QWEATHER_BUDGET_CONFIRMED=false
HYHQ_QWEATHER_MONTHLY_LIMIT=15000
# 仅生产网页启用后台抓取。本机关闭，所有浏览接口始终只读缓存。
HYHQ_WEATHER_BACKGROUND_ENABLED=false
HYHQ_MANAGEMENT_ENABLED=true
HYHQ_COMMUNITY_ENABLED=false
HYHQ_FEEDBACK_ENABLED=false
# 腾讯地图 JavaScript API GL 浏览器 Key，限制 greatdata.asia 授权域名；缺失时提供备用底图。
TENCENT_MAP_JS_KEY=
# 预留，当前只生成站内通知，没有 SMTP 邮件发送器。
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# 生产反向代理必须覆盖 X-Forwarded-For；仅本机回环代理可被信任。
HYHQ_TRUST_PROXY=
# 网页地图 JS Key 必须在腾讯控制台限制授权域名；这是浏览器用Key，不是服务端私钥。
# TENCENT_MAP_JS_KEY 上方已列出。
HYHQ_OPERATOR_NAME=
HYHQ_CONTACT_EMAIL=
HYHQ_ICP_NUMBER=
