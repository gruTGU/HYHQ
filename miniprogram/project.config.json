{
  "description": "HYHQ 海晏河清 · 生态科普、自然观察与绿色生活",
  "miniprogramRoot": "./",
  "projectname": "HYHQ",
  "appid": "touristappid",
  "compileType": "miniprogram",
  "libVersion": "3.7.12",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "swc": false,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "project.private.config.example.json"
      },
      {
        "type": "file",
        "value": "config/local.example.js"
      },
      {
        "type": "file",
        "value": "package.json"
      }
    ]
  }
}
