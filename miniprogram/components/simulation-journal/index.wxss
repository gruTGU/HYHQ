.simulation-journal { margin-top: 32rpx; padding: 28rpx; border: 1rpx solid var(--hyhq-border,#dce5d6); border-radius: var(--hyhq-card-radius,32rpx); background: var(--hyhq-surface,#fffefa); color: var(--hyhq-text,#2c3e33); }
.simulation-heading { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }.simulation-title { font-size:30rpx;font-weight:600; }.simulation-label { font-size:19rpx;color:var(--hyhq-secondary-text,#55734f);white-space:nowrap; }.simulation-campus { margin-top:12rpx;font-size:24rpx;color:var(--hyhq-muted,#768573); }
.simulation-links { display:flex; gap:12rpx; margin:26rpx 0; }.simulation-link { display:flex; flex:1; flex-direction:column; align-items:flex-start; justify-content:center; gap:8rpx; padding:20rpx 16rpx; min-width:0; margin:0; line-height:1.5; border-radius:18rpx; color:var(--hyhq-text,#2c3e33); background:var(--hyhq-secondary,#eaf0e4); font-size:25rpx; }.simulation-links .small {font-size:19rpx;color:var(--hyhq-muted,#768573);}
.simulation-button::after{border:0}.simulation-scenarios { display:flex; flex-wrap:wrap; gap:10rpx; }.scenario-button {display:flex;align-items:center;justify-content:center;flex:1 1 40%;margin:0;padding:16rpx 8rpx;line-height:1.2;font-size:23rpx;border:1rpx solid var(--hyhq-border,#dce5d6);border-radius:28rpx;color:inherit;background:transparent;}.scenario-button.selected{background:var(--hyhq-primary,#3a7d5c);border-color:var(--hyhq-primary,#3a7d5c);color:#fff;}
.simulation-subtitle{margin:30rpx 0 20rpx;font-size:26rpx;font-weight:500}.simulation-metrics{display:flex;gap:6rpx}.metric-button{flex:1;min-width:0;padding:16rpx 4rpx;margin:0;background:transparent;color:inherit;border:1rpx solid transparent;border-radius:16rpx;line-height:1.3;text-align:center}.metric-button.active{border-color:var(--hyhq-primary,#3a7d5c);background:var(--hyhq-secondary,#eaf0e4)}.metric-label{display:block;font-size:21rpx;color:var(--hyhq-muted,#768573);margin-bottom:12rpx}.metric-value{font-size:32rpx;font-weight:600}.metric-unit{font-size:17rpx;margin-left:3rpx;color:var(--hyhq-muted,#768573)}
.simulation-canvas,.simulation-chart-placeholder{display:block;pointer-events:none;width:100%;height:160px;margin-top:18rpx}.simulation-axis{display:flex;justify-content:space-between;font-size:19rpx;color:var(--hyhq-muted,#768573)}.simulation-note{font-size:19rpx;line-height:1.7;color:var(--hyhq-muted,#768573);margin-top:14rpx}.simulation-explanation{display:flex;flex-direction:column;gap:12rpx;margin-top:26rpx;padding:22rpx;border-radius:18rpx;background:var(--hyhq-secondary,#eaf0e4);font-size:24rpx;line-height:1.8}.explanation-title{font-weight:600;font-size:27rpx}.table-toggle{display:flex;align-items:center;justify-content:center;margin:18rpx 0 0;width:100%;padding:18rpx 0;color:var(--hyhq-secondary-text,#55734f);font-size:22rpx;line-height:1.4;background:transparent}.table-row{display:flex;align-items:center;border-bottom:1rpx solid var(--hyhq-border,#dce5d6);padding:14rpx 0;font-size:21rpx}.table-cell{flex:1;text-align:right}.table-time{text-align:left}.table-heading{font-weight:500;font-size:20rpx}.table-unit{display:block;font-size:17rpx;color:var(--hyhq-muted,#768573)}
.simulation-reminder{display:flex;align-items:center;justify-content:center;width:100%;min-height:76rpx;margin:20rpx 0 0;padding:18rpx 24rpx;border:1rpx solid var(--hyhq-border,#dce5d6);border-radius:18rpx;font-size:24rpx;line-height:1.5;color:var(--hyhq-secondary-text,#55734f);background:var(--hyhq-secondary,#eaf0e4)}
