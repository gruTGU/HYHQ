<view class="card section"><view class="title">此地点近期活动</view><view wx:if="{{loading}}" class="copy">正在查询活动…</view><view wx:elif="{{error}}" class="copy">{{error}}<button class="activity-button activity-text-button text-button" bindtap="load">重试</button></view><view wx:elif="{{!items.length}}" class="copy">近期30天暂无已整理活动。</view><view wx:for="{{items}}" wx:key="id" class="event-line"><view>{{item.title}} · 演示</view><view class="small muted">{{item.time_label}}</view></view><button class="activity-button secondary gap" bindtap="open">查看活动与年度花季</button><view class="small muted gap">演示安排，非场地方公告。</view></view>
