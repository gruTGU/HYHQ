.result-card { padding: 30rpx; background: var(--hyhq-surface, #fffefa); border-radius: var(--hyhq-card-radius, 32rpx); margin-top: 24rpx; color: var(--hyhq-text, #2c3e33); }
.result-eyebrow { font-size: 18rpx; letter-spacing: 2rpx; color: var(--hyhq-primary, #719358); }
.result-heading { font-size: 37rpx; font-weight: 600; line-height: 1.5; margin: 12rpx 0; }
.result-copy { font-size: 25rpx; line-height: 1.8; color: var(--hyhq-muted, #65796c); }
.candidate-title { font-size: 24rpx; color: var(--hyhq-muted, #65796c); margin-top: 28rpx; margin-bottom: 10rpx; }
.candidate { margin-top: 22rpx; }
.candidate-row { display: flex; justify-content: space-between; align-items: center; }
.candidate-rank { color: var(--hyhq-muted, #94a57e); font-size: 23rpx; margin-right: 16rpx; }
.candidate-name { font-size: 27rpx; font-weight: 500; }
.candidate-score { color: var(--hyhq-muted, #798a6b); font-size: 22rpx; }
.score-track { width: 100%; height: 8rpx; border-radius: 9rpx; background: var(--hyhq-secondary, #edf1e6); overflow: hidden; margin-top: 14rpx; }
.score-fill { height: 100%; background: var(--hyhq-accent, #a8c99b); border-radius: 9rpx; }
.content-link { margin: 10rpx 0 0 auto; padding: 0; background: transparent; color: var(--hyhq-primary, #598144); font-size: 22rpx; line-height: 2; text-align: right; }
.result-action::after { border: 0; }
.score-note { font-size: 22rpx; color: var(--hyhq-muted, #697d6e); line-height: 1.8; margin-top: 24rpx; }
.model-meta { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid var(--hyhq-border, #edf0e4); font-size: 21rpx; color: var(--hyhq-muted, #697d6e); line-height: 1.8; }
.disclaimer { background: var(--hyhq-notice, #f1f3e7); border-radius: 14rpx; padding: 16rpx; font-size: 22rpx; color: var(--hyhq-muted, #778463); line-height: 1.8; margin-top: 20rpx; }
.retake { background: var(--hyhq-secondary, #e5efdf); color: var(--hyhq-secondary-text, #326849); border-radius: var(--hyhq-button-radius, 18rpx); font-size: 25rpx; line-height: 2.9; margin: 24rpx 0 0; }
.uncertain .result-eyebrow { color: var(--hyhq-warning, #9a8755); }
.uncertain .result-heading { color: var(--hyhq-warning, #7e704a); }
.uncertain .score-fill { background: var(--hyhq-accent, #b5ac7e); }
