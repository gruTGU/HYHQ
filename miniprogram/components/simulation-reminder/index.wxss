.reminder-overlay{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box;color:var(--hyhq-text,#2c3e33)}.reminder-mask{position:absolute;inset:0;background:rgba(17,32,24,.52)}.reminder-dialog{position:relative;z-index:1;box-sizing:border-box;width:100%;max-width:640rpx;max-height:85vh;overflow-y:auto;padding:32rpx;border:1rpx solid var(--hyhq-border,#dce5d6);border-radius:32rpx;background:var(--hyhq-surface,#fffefa);box-shadow:0 20rpx 80rpx rgba(0,0,0,.15)}.reminder-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:22rpx}.reminder-title{font-size:32rpx;font-weight:600}.reminder-copy,.reminder-note,.reminder-error,.reminder-notice{display:block;font-size:25rpx;line-height:1.75}.reminder-note{margin-top:18rpx;font-size:22rpx;color:var(--hyhq-muted,#768573)}.reminder-preview{padding:24rpx;margin:24rpx 0;border-radius:20rpx;background:var(--hyhq-secondary,#eaf0e4);font-size:28rpx;line-height:1.7}.reminder-preview-label{display:block;font-size:21rpx;color:var(--hyhq-muted,#768573);margin-bottom:12rpx}.reminder-error{margin-top:18rpx;font-size:23rpx;color:var(--hyhq-warning,#ae6840)}.reminder-notice{margin-top:18rpx;font-size:24rpx;color:var(--hyhq-primary,#3a7d5c)}.reminder-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;margin:0;line-height:1.5;text-align:center;border-radius:20rpx}.reminder-button::after{border:0}.reminder-dialog .reminder-close{flex:none;width:56rpx;height:56rpx;padding:0;background:transparent;color:var(--hyhq-muted,#768573);font-size:38rpx}.reminder-dialog .reminder-primary{width:100%;min-height:88rpx;padding:18rpx 20rpx;margin-top:28rpx;background:var(--hyhq-primary,#3a7d5c);color:#fff;font-size:26rpx}.reminder-dialog .reminder-secondary{width:100%;min-height:72rpx;padding:16rpx 20rpx;margin-top:10rpx;background:transparent;color:var(--hyhq-muted,#768573);font-size:25rpx}.reminder-button.is-disabled{opacity:.55}
