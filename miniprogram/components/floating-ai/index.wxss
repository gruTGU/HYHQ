.floating-ai { position: fixed; z-index: 40; right: 20px; bottom: calc(24px + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100rpx; height: 100rpx; min-width: 100rpx; max-width: 100rpx; min-height: 100rpx; max-height: 100rpx; flex: 0 0 100rpx; margin: 0; padding: 0; font-size: 0; line-height: 0; background: var(--hyhq-surface, #fffefa); border: 2rpx solid var(--hyhq-border, #cfddc9); border-radius: 50%; box-shadow: 0 8rpx 30rpx rgba(44,62,51,.15); transition: transform 120ms ease; }
.floating-ai::after { border: 0; }
.floating-ai.above-tab { bottom: calc(84px + env(safe-area-inset-bottom)); }
.assistant-star { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: block; width: 50rpx; height: 50rpx; margin: 0; padding: 0; pointer-events: none; }
.ai-pressed { transform: scale(.97); }
