.tab-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: #fffefa; border-top: 1rpx solid #e7ecdf; padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); box-shadow: 0 -8rpx 30rpx rgba(48, 79, 50, .035); }
.tab-items { display: flex; align-items: center; height: 112rpx; padding: 0 25rpx; overflow: visible; }
.tab-item { box-sizing: border-box; display: flex; position: relative; flex: 1 1 0; width: 0; min-width: 0; height: 112rpx; align-items: center; justify-content: center; margin: 0; padding: 0; border: none; border-radius: 24rpx; background: transparent; line-height: 1; overflow: visible; }
.tab-item::after { border: none; }
.tab-icon, .ai-circle, .tab-indicator { left: 50%; transform: translateX(-50%); }
.tab-icon { display: block; position: absolute; top: 8rpx; width: 60rpx; height: 60rpx; overflow: hidden; opacity: .5; }
.ai-glyph { display: block; position: relative; width: 80rpx; height: 80rpx; overflow: hidden; }
.tab-sprite { position: absolute; display: block; width: 300%; height: 200%; max-width: none; }
.sprite-home { left: 0; top: 0; }
.sprite-explore { left: -100%; top: 0; }
/* AI ink bounds in its 512px tile: x=58..421, y=127..449.
   Compensate the original artwork's uneven whitespace without editing it. */
.sprite-ai { left: -196.77734375%; top: -6.25%; }
.sprite-learn { left: 0; top: -100%; }
.sprite-profile { left: -100%; top: -100%; }
.tab-label { box-sizing: border-box; position: absolute; display: block; left: 0; right: 0; width: 100%; bottom: 15rpx; text-align: center; font-size: 20rpx; line-height: 24rpx; white-space: nowrap; color: #697d6e; font-weight: 400; }
.is-selected .tab-label { color: #3a7d5c; font-weight: 600; }
.is-selected .tab-icon { opacity: 1; }
.ai-circle { box-sizing: border-box; position: absolute; top: -32rpx; display: flex; width: 108rpx; height: 108rpx; align-items: center; justify-content: center; border: 7rpx solid #e6ecdf; border-radius: 50%; background: #fffefa; box-shadow: 0 5rpx 15rpx rgba(40, 85, 55, .13); overflow: hidden; }
.is-selected .ai-circle { border-color: #a8bfaa; }
.tab-pressed { transform: scale(.97); opacity: .8; }
.tab-icon, .ai-circle, .tab-sprite, .tab-label, .tab-indicator { pointer-events: none; }
.tab-hit { position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 2; background: rgba(255, 254, 250, .001); }
.ai-item .tab-hit { top: -32rpx; }

.tab-item { transition: transform 120ms ease; }
.tab-indicator { position: absolute; bottom: 7rpx; width: 12rpx; height: 4rpx; border-radius: 4rpx; background: #3a7d5c; }
