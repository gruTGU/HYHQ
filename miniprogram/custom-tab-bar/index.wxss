.tab-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: var(--hyhq-surface, #fffefa); border-top: 1rpx solid #e7ecdf; padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); box-shadow: 0 -8rpx 30rpx rgba(48, 79, 50, .035); }
.tab-items { display: flex; align-items: center; height: 112rpx; padding: 0 25rpx; overflow: visible; }
.tab-item { box-sizing: border-box; display: flex; position: relative; flex: 1 1 0; width: 0; min-width: 0; height: 112rpx; align-items: center; justify-content: center; margin: 0; padding: 0; border: none; border-radius: 24rpx; background: transparent; line-height: 1; overflow: visible; }
.tab-item::after { border: none; }
.tab-icon, .recognition-circle, .tab-indicator { left: 50%; transform: translateX(-50%); }
.tab-icon { display: block; position: absolute; top: 8rpx; width: 60rpx; height: 60rpx; overflow: hidden; opacity: .5; }
.tab-sprite { position: absolute; display: block; width: 300%; height: 200%; max-width: none; }
.sprite-home { left: 0; top: 0; }
.sprite-explore { left: -100%; top: 0; }
.sprite-learn { left: 0; top: -100%; }
.sprite-profile { left: -100%; top: -100%; }
.tab-label { box-sizing: border-box; position: absolute; display: block; left: 0; right: 0; width: 100%; bottom: 15rpx; text-align: center; font-size: 20rpx; line-height: 24rpx; white-space: nowrap; color: #697d6e; font-weight: 400; }
.is-selected .tab-label { color: var(--hyhq-primary, #3a7d5c); font-weight: 600; }
.is-selected .tab-icon { opacity: 1; }
.recognition-circle { box-sizing: border-box; position: absolute; top: -32rpx; display: flex; width: 108rpx; height: 108rpx; align-items: center; justify-content: center; border: 7rpx solid #e6ecdf; border-radius: 50%; background: var(--hyhq-surface, #fffefa); box-shadow: 0 5rpx 15rpx rgba(40, 85, 55, .13); overflow: hidden; }
.is-selected .recognition-circle { border-color: #a8bfaa; }
.tab-pressed { transform: scale(.97); opacity: .8; }
.tab-icon, .recognition-circle, .tab-sprite, .tab-label, .tab-indicator { pointer-events: none; }
.tab-hit { position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 2; background: rgba(255, 254, 250, .001); }
.recognition-item .tab-hit { top: -32rpx; }

.tab-item { transition: transform 120ms ease; }
.tab-indicator { position: absolute; bottom: 7rpx; width: 12rpx; height: 4rpx; border-radius: 4rpx; background: var(--hyhq-primary, #3a7d5c); }
.theme-design-2.tab-bar, .theme-design-3.tab-bar { border-color: var(--hyhq-border); box-shadow: none; }
.theme-design-2 .recognition-circle, .theme-design-3 .recognition-circle { border: 5rpx solid var(--hyhq-background); background: var(--hyhq-primary); color: var(--hyhq-surface); box-shadow: none; }
.theme-design-2 .tab-label, .theme-design-3 .tab-label { color: var(--hyhq-muted); }
.theme-design-2 .is-selected .tab-label, .theme-design-3 .is-selected .tab-label { color: var(--hyhq-primary); }
.theme-symbol { position: absolute; left: 50%; top: 8rpx; transform: translateX(-50%); width: 56rpx; height: 56rpx; color: var(--hyhq-text); pointer-events: none; }
.is-selected .theme-symbol { color: var(--hyhq-primary); }
.symbol-one, .symbol-two { position: absolute; box-sizing: border-box; }
.symbol-home .symbol-one { width: 29rpx; height: 26rpx; top: 25rpx; left: 14rpx; border: 3rpx solid currentColor; border-top: 0; }
.symbol-home .symbol-two { width: 29rpx; height: 29rpx; left: 14rpx; top: 12rpx; border-left: 3rpx solid currentColor; border-top: 3rpx solid currentColor; transform: rotate(45deg); }
.symbol-learn .symbol-one, .symbol-learn .symbol-two { width: 22rpx; height: 34rpx; top: 14rpx; border: 3rpx solid currentColor; }
.symbol-learn .symbol-one { left: 7rpx; border-radius: 4rpx 7rpx 0 4rpx; transform: skewY(8deg); }
.symbol-learn .symbol-two { right: 7rpx; border-radius: 7rpx 4rpx 4rpx 0; transform: skewY(-8deg); }
.symbol-profile .symbol-one { width: 20rpx; height: 20rpx; top: 8rpx; left: 18rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.symbol-profile .symbol-two { width: 36rpx; height: 20rpx; top: 33rpx; left: 10rpx; border: 3rpx solid currentColor; border-radius: 22rpx 22rpx 3rpx 3rpx; }

/* Same upright, continuous path as My Records / visit. No rotated border pieces. */
.symbol-explore { background-position: center; background-size: 56rpx 56rpx; background-repeat: no-repeat; }
.symbol-explore { background-image: url("data:image/svg+xml;base64,"); }
.theme-design-2 .symbol-explore { background-image: url("data:image/svg+xml;base64,"); }
.theme-design-2 .is-selected .symbol-explore { background-image: url("data:image/svg+xml;base64,"); }
.theme-design-3 .symbol-explore { background-image: url("data:image/svg+xml;base64,"); }
.theme-design-3 .is-selected .symbol-explore { background-image: url("data:image/svg+xml;base64,"); }
.theme-forest .symbol-explore { opacity: .5; }
.theme-forest .is-selected .symbol-explore { opacity: 1; }

/* Symmetric 24 × 24 camera artwork: painted bounds are centered at (12, 12). */
.camera-mark { display: block; flex: 0 0 68rpx; width: 68rpx; height: 68rpx; margin: 0; padding: 0; background-position: center; background-size: contain; background-repeat: no-repeat; pointer-events: none; background-image: url("data:image/svg+xml;base64,"); }
.theme-design-2 .camera-mark { background-image: url("data:image/svg+xml;base64,"); }
.theme-design-3 .camera-mark { background-image: url("data:image/svg+xml;base64,"); }
