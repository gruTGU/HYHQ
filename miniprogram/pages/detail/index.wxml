<view class="page detail-page">
  <page-state loading="{{loading}}" error="{{error}}" bindretry="load" />
  <block wx:if="{{!loading && !error && item}}">
    <text class="eyebrow">{{kind === 'place' ? 'PLACE / 生态地点' : kind === 'content' ? 'JOURNAL / 科普手记' : 'ROUTE / 绿色漫步'}}</text>
    <view class="page-title">{{item.name || item.title}}</view>
    <view class="row gap"><source-label source="manual" /><text class="pill" wx:if="{{item.is_demo}}">科普模拟资料</text></view>
    <narration-player wx:if="{{kind === 'content' || kind === 'route'}}" kind="{{kind}}" target-id="{{item.id}}" />
    <view class="card section"><view class="copy detail-copy">{{item.description || item.summary || '暂无简介'}}</view><block wx:if="{{kind === 'content'}}"><view class="divider"></view><view class="article"><markdown-view content="{{item.body}}" /></view><view class="small muted section source-reference">资料来源：{{item.source || '管理员整理'}}</view><view class="small muted">更新：{{item.updated_label}}</view></block><block wx:if="{{kind === 'place'}}"><view class="small muted gap">所属区域：{{item.region_name}}</view><view class="small muted source-reference">资料说明：{{item.source_note || '管理员整理的地点资料'}}</view></block></view>
    <view class="section" wx:if="{{kind === 'route'}}">
      <view class="section-head"><text class="section-title">沿途停留</text><text class="small muted">{{routeStops.length}} 个公开节点</text></view>
      <view class="small muted">所属区域：{{item.region_name || '以地点资料为准'}}</view><view class="small muted gap source-reference">路线出处：{{item.source || '尚未填写出处'}}</view>
      <view wx:if="{{!routeStops.length}}" class="notice">此路线暂没有可浏览的公开节点。节点调整或下架后不会继续显示其资料。</view>
      <view class="route-stop {{activeStop.id === item.id ? 'stop-selected' : ''}}" wx:for="{{routeStops}}" wx:key="id" data-id="{{item.id}}" bindtap="selectRouteStop" hover-class="pressable" aria-role="button"><view class="stop-index">{{item.position}}</view><view class="grow"><view class="title">{{item.place.name}}</view><view class="copy">{{item.note || item.place.description}}</view></view><text class="small muted">{{activeStop.id === item.id ? '浏览中' : '选择'}}</text></view>
      <view wx:if="{{activeStop}}" class="card section"><text class="pill">浏览第 {{activeStop.position}} / {{routeStops.length}} 站</text><view class="title gap">{{activeStop.place.name}}</view><view class="copy">{{activeStop.note || activeStop.place.description}}</view><view class="actions"><button class="secondary" data-direction="previous" bindtap="stepRoute" disabled="{{stopIndex === 0}}">上一站</button><button class="secondary" data-direction="next" bindtap="stepRoute" disabled="{{stopIndex === routeStops.length - 1}}">下一站</button></view><button class="primary gap" bindtap="openRouteStop">查看此地点详情</button><view class="small muted gap">查看地点后，可通过左上角返回本路线。选择节点仅切换浏览内容，不记录到访。</view></view>
      <button class="secondary gap" bindtap="openRouteList">返回本区域的路线列表</button><view class="notice">路线为管理员预设，不包含实时导航或到访核验；实际出行需自行核实开放范围和天气。</view>
    </view>
    <view wx:if="{{kind === 'content' && (item.place_summary || item.plant_label)}}" class="section"><view class="section-title">继续探索</view><button wx:if="{{item.place_summary}}" class="secondary gap" bindtap="openAssociatedPlace">关联地点 · {{item.place_summary.name}}</button><button wx:if="{{item.plant_label}}" class="secondary gap" bindtap="openPlantContents">查看同类植物的科普</button></view>
    <view wx:if="{{kind === 'place'}}" class="section"><view class="section-head"><text class="section-title">与此处相关的科普</text><text class="small muted" wx:if="{{relatedCount}}">{{relatedCount}} 篇</text></view><page-state loading="{{relatedLoading}}" error="{{relatedError}}" empty="{{!relatedLoading && !relatedError && !relatedContents.length}}" empty-text="此地点暂无公开关联文章。" bindretry="loadRelatedContents" /><view wx:if="{{!relatedLoading && !relatedError}}"><view class="card" wx:for="{{relatedContents}}" wx:key="id" data-id="{{item.id}}" bindtap="openRelatedContent" hover-class="pressable" aria-role="button"><view class="title">{{item.title}}</view><view class="copy">{{item.summary}}</view><view class="small muted gap source-reference">资料来源：{{item.source || '尚未填写出处'}}</view></view><button wx:if="{{relatedCount}}" class="secondary" bindtap="openRelatedContents">在科普页浏览全部关联文章</button></view></view>
    <view class="section" wx:if="{{kind === 'place' && item.water_body_id}}"><button class="primary" bindtap="openWater">查看此水体的指标与趋势</button></view>
    <button wx:if="{{communityEnabled}}" class="secondary section" bindtap="openComments">交流与反馈 ↗</button>
    <view class="actions" wx:if="{{kind !== 'route'}}"><button class="secondary" disabled="{{busy}}" loading="{{busy}}" bindtap="toggleFavorite">{{favoriteId ? '取消收藏' : '收藏资料'}}</button><button wx:if="{{kind === 'place'}}" class="primary" disabled="{{busy}}" bindtap="visit">记录游览</button></view>
    <view class="error-inline" wx:if="{{recordError}}">个人记录同步失败：{{recordError}}</view>
    <view class="section" wx:if="{{stations.length || observationError}}"><view class="section-head"><text class="section-title">科普模拟观测</text><source-label source="simulation" /></view><picker wx:if="{{stations.length}}" range="{{stations}}" range-key="name" value="{{stationIndex}}" bindchange="changeStation"><view class="card row"><text>{{stations[stationIndex].name}}</text><text class="chevron">⌄</text></view></picker><button wx:if="{{stations.length}}" class="secondary gap" bindtap="openDataCenter">在数据中心查看此站趋势</button><view class="gap"><page-state loading="{{observationLoading}}" error="{{observationError}}" empty="{{!observationLoading && !observationError && !observations.length}}" empty-text="该监测站暂无模拟观测。" bindretry="loadObservations" /></view><view class="observation" wx:for="{{observations}}" wx:key="id"><view class="row"><text>{{item.metric_name}}</text><text class="observation-value">{{item.value_label}} <text class="small muted">{{item.unit}}</text></text></view><view class="small muted">{{item.time_label}} · {{item.quality_label}}</view></view><view class="notice">这里展示科普模拟观测，不代表真实环境。缺失值保留为空缺，不输出官方水质类别；完整窗口、来源与批次可在数据中心查看。</view></view>
  </block>
  <floating-ai visible="{{!loading && !error && item}}" bindopen="openAI" />
</view>
