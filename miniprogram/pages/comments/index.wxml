<view class="page comments-page">
  <text class="eyebrow">GROW TOGETHER / 生态同行</text>
  <view class="page-title">{{mode === 'mine' ? '我的评论' : mode === 'reports' ? '我的举报' : '留下观察与发现'}}</view>
  <view class="subtitle">{{mode === 'reports' ? '举报仅供你和获授权的管理员查看。' : '围绕眼前的内容，分享真实、友善的观察。'}}</view>
  <view wx:if="{{invalid}}" class="card notice">内容入口无效，请返回原页面重新打开。</view>
  <block wx:else>
    <view wx:if="{{loggedIn}}" class="records-nav"><button class="text-button" bindtap="myComments" disabled="{{busy}}">我的评论</button><button class="text-button" bindtap="myReports" disabled="{{busy}}">我的举报</button></view>
    <view wx:if="{{mode === 'target' && statusKnown && !enabled}}" class="card closed-state"><view class="leaf-mark"></view><view class="title">评论与举报暂未开放</view><view class="copy">你仍可以继续阅读，也可以在个人中心提交私密反馈。</view></view>
    <view wx:if="{{!loggedIn && (enabled || mode !== 'target')}}" class="card"><view class="title">登录后管理你的记录</view><view class="copy">评论审核通过后公开，举报始终保持私密。</view><button class="primary gap" bindtap="login">去登录</button></view>
    <view wx:if="{{mode === 'target' && enabled && loggedIn}}" class="card comment-form"><view class="section-head"><text class="section-title">分享观察</text><text class="small muted">审核后公开</text></view><textarea value="{{body}}" disabled="{{busy}}" maxlength="500" placeholder="写下与这篇内容有关的观察、补充或疑问。" bindinput="inputBody" /><view class="count small muted">{{bodyCount}} / 500 字</view><view class="form-hint">请勿填写联系方式、住址等个人隐私。评论文字将交由微信内容安全服务检查并由管理员审核。</view><button class="primary gap" hover-class="pressable" bindtap="submit" loading="{{busy}}" disabled="{{busy || !bodyCount}}">提交评论</button></view>
    <view wx:if="{{actionError}}" class="error-inline">{{actionError}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <page-state loading="{{loading}}" error="{{!records.length ? listError : ''}}" bindretry="load" />
    <view wx:if="{{records.length && listError}}" class="error-inline">{{listError}}<button class="text-button" bindtap="load" disabled="{{busy}}">重新加载</button></view>
    <view wx:if="{{!loading && !listError && !records.length && (enabled || mode !== 'target') && (loggedIn || mode === 'target')}}" class="card empty-record"><view class="title">{{mode === 'reports' ? '还没有举报记录' : mode === 'mine' ? '还没有评论记录' : '这里还没有公开的评论'}}</view><view class="copy">{{mode === 'target' ? '每一份细心的观察，都值得友善交流。' : '提交后可在这里查看处理状态。'}}</view></view>
    <view wx:for="{{records}}" wx:key="id" class="card comment-record"><view class="record-head"><text class="record-author">{{mode === 'reports' ? item.reason_label : item.author}}</text><text class="status-chip {{item.status === 'approved' || item.status === 'resolved' ? 'approved' : ''}}">{{item.status_label}}</text></view><view class="record-body">{{mode === 'reports' ? (item.detail || '未补充说明') : item.body}}</view><view class="record-foot"><text class="small muted">{{item.created_label}}</text><button wx:if="{{mode !== 'reports' && item.is_owner}}" class="text-button" data-id="{{item.id}}" disabled="{{busy}}" bindtap="remove">删除</button><button wx:elif="{{mode !== 'reports' && item.status === 'approved' && enabled && loggedIn}}" class="text-button" data-id="{{item.id}}" disabled="{{busy}}" bindtap="openReport">举报</button></view></view>
    <view wx:if="{{moreError}}" class="error-inline">{{moreError}}</view><button wx:if="{{next}}" class="secondary gap" bindtap="more" loading="{{loadingMore}}" disabled="{{busy || loading || loadingMore}}">加载更多</button>
    <button wx:if="{{enabled && loggedIn && mode === 'target'}}" class="text-button report-content" bindtap="openReport" disabled="{{busy}}">这篇内容有问题 · 举报</button>
    <view wx:if="{{reportTarget}}" class="card report-form"><view class="section-head"><text class="section-title">举报内容问题</text><button class="text-button" disabled="{{busy}}" bindtap="closeReport">取消</button></view><picker range="{{reasons}}" range-key="label" value="{{reasonIndex}}" bindchange="selectReason" disabled="{{busy}}"><view class="reason-select">{{reasons[reasonIndex].label}}<text>选择原因 ›</text></view></picker><textarea value="{{reportDetail}}" maxlength="300" disabled="{{busy}}" placeholder="补充说明（选填，300 字以内），请勿填写个人隐私。" bindinput="inputReport" /><view class="form-hint">举报供管理员核实处理，不会向其他用户公开。</view><button class="primary gap" bindtap="submitReport" loading="{{busy}}" disabled="{{busy}}">确认提交举报</button></view>
    <view class="footer-note">评论、举报及其个人记录在注销账号时清除。</view>
  </block>
</view>
