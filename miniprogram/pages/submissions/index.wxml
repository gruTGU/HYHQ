<view style="{{themeStyle}};{{themeAssetStyle}}" class="page theme-{{themeId}} {{themeId !== 'forest' ? 'theme-designed' : ''}} submissions-page">
  <view class="title">我的资料反馈</view><view class="copy section">原始反馈保持私密。公开科普由编辑核实整理，文章不开放评论。</view>
  <view wx:if="{{!loggedIn}}" class="card section"><view class="copy">登录后保存私人草稿、向编辑反馈资料并查看处理进度。</view><button class="primary gap" bindtap="login">前往登录</button></view>
  <block wx:else>
    <view wx:if="{{!enabled}}" class="notice section">{{reason || '资料反馈尚未开放，私人草稿可以保存。'}}</view>
    <view class="actions section"><button class="primary" disabled="{{busy}}" bindtap="create">写资料反馈</button><button class="secondary" disabled="{{busy}}" bindtap="load">刷新记录</button></view>
    <view wx:if="{{error}}" class="error-inline section">{{error}}</view><view wx:if="{{notice}}" class="notice section">{{notice}}</view>
    <view wx:if="{{editor}}" class="card editor section">
      <view class="row"><text class="subtitle">{{editor.status_label || '私人草稿'}}</text><button class="text-button" disabled="{{busy}}" bindtap="closeEditor">收起</button></view>
      <block wx:if="{{editor.status === 'draft' || editor.status === 'rejected' || editor.status === 'withdrawn'}}">
        <input value="{{editor.title}}" placeholder="标题（80字以内）" maxlength="80" data-field="title" bindinput="field" disabled="{{busy}}" />
        <picker range="{{categories}}" range-key="name" value="{{editor.categoryIndex}}" bindchange="category" disabled="{{busy}}"><view class="selector">{{categories[editor.categoryIndex].name}} ⌄</view></picker>
        <textarea value="{{editor.body}}" placeholder="补充线索、纠错或自然观察（2000字以内）" maxlength="2000" data-field="body" bindinput="field" disabled="{{busy}}" />
        <textarea class="source" value="{{editor.source}}" placeholder="参考来源（选填，300字以内）" maxlength="300" data-field="source" bindinput="field" disabled="{{busy}}" />
        <view class="actions"><button class="primary" bindtap="save" disabled="{{busy}}">保存私人草稿</button><button wx:if="{{enabled && editor.id}}" class="secondary" bindtap="submit" disabled="{{busy}}">提交给编辑</button></view>
      </block>
      <block wx:else><view class="subtitle gap">{{editor.title}}</view><view class="article-body gap">{{editor.body}}</view><view wx:if="{{editor.source}}" class="copy gap">来源：{{editor.source}}</view></block>
      <view wx:if="{{editor.review_reason}}" class="notice gap">{{editor.review_reason}}</view>
      <view wx:if="{{enabled}}" class="copy gap">原始反馈仅你和授权编辑可见，永不直接公开。提交时进行微信内容检查；编辑核实、改写并再次检查后，可能形成官方文章。请勿填写姓名、联系方式等隐私。</view>
      <view wx:if="{{editor.id}}" class="actions gap"><button wx:if="{{editor.status === 'pending' || editor.status === 'checking' || editor.status === 'reviewing' || editor.status === 'approved'}}" class="secondary" data-action="withdraw" bindtap="action" disabled="{{busy}}">撤回</button><button class="text-button" data-action="delete" bindtap="action" disabled="{{busy}}">删除反馈</button></view>
    </view>
    <view wx:for="{{rows}}" wx:key="id" class="card section" data-id="{{item.id}}" bindtap="edit"><view class="subtitle">{{item.title || '未命名草稿'}}</view><view class="row gap"><text class="badge">{{item.status_label}}</text><text class="small muted">{{item.time_label}}</text></view></view>
    <view wx:if="{{!rows.length && !busy}}" class="copy section">还没有资料反馈，可以先保存一份私人草稿。</view><button wx:if="{{next}}" class="secondary" bindtap="more" disabled="{{busy}}">加载更多</button>
  </block>
</view>
