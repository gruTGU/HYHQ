<view class="page weather-page">
  <view class="weather-heading"><text class="eyebrow">WEATHER JOURNAL</text><text class="page-title">出发前，看一眼天空</text><text class="muted">接下来的天气，和一次恰好的提醒。</text></view>
  <picker wx:if="{{locations.length}}" range="{{locations}}" range-key="name" value="{{locationIndex}}" disabled="{{busy}}" bindchange="changeLocation"><view class="location-picker" hover-class="pressable"><view><text class="eyebrow">天气地点</text><text class="location-name">{{location.name}}</text></view><text class="picker-arrow">⌄</text></view></picker>
  <text wx:if="{{location.scope_note}}" class="scope-note">{{location.scope_note}}</text>
  <page-state loading="{{loading}}" error="{{error}}" bind:retry="load" />
  <view wx:if="{{!loading && !forecastEnabled}}" class="card empty-card"><text class="section-title">天气预报暂未开放</text><text class="muted">你仍可回到首页查看已接入地点的天气、空气质量与预警。</text></view>
  <view wx:elif="{{!loading && forecast && !forecast.available}}" class="card empty-card"><text class="section-title">暂时没有可用预报</text><text class="muted">稍后下拉刷新，再安排这趟出行。</text></view>
  <view wx:if="{{forecast.available}}" class="forecast-section">
    <view class="section-heading"><text class="section-title">接下来三天</text><text class="status {{forecast.stale ? 'status-stale' : ''}}">{{forecast.status_label}}</text></view>
    <view wx:for="{{forecast.days}}" wx:key="starts_at" class="card forecast-day"><view class="forecast-top"><text class="day-date">{{item.date_label}}</text><text class="temperature">{{item.temperature_label}}</text></view><text class="condition">{{item.condition_label}}</text><view class="forecast-meta"><text>夜间 {{item.night_label}}</text><text>白天降水概率 {{item.rain_label}}</text></view></view>
    <view class="source-footer"><text>来源：{{forecast.source_label}} · 更新 {{forecast.fetched_label}}</text><text wx:if="{{forecast.attribution}}" user-select="true">{{forecast.attribution}}</text><button class="text-button" bindtap="copySource">查看来源地址</button></view>
  </view>
  <view class="card reminder-card"><text class="eyebrow">A GENTLE REMINDER</text><text class="section-title">明早出发前提醒我</text><text class="muted">{{subscriptionNotice || '天气提醒暂未开放。'}}</text>
    <block wx:if="{{subscriptionEnabled}}"><button wx:if="{{!loggedIn || !wechatLogin}}" class="secondary" hover-class="pressable" bindtap="login">使用微信登录后设置</button><button wx:elif="{{!intent}}" class="primary" hover-class="pressable" disabled="{{busy || !location}}" loading="{{busy}}" bindtap="prepareReminder">设置明早提醒</button></block>
    <view wx:if="{{intent}}" class="intent-panel"><text class="intent-title">{{intent.location_name}}</text><text class="muted">{{intent.scheduled_label}} · 仅本次</text><button wx:if="{{!canConfirmAgain}}" class="primary" hover-class="pressable" disabled="{{busy}}" loading="{{busy}}" bindtap="authorizeReminder">授权这次提醒</button></view>
    <button wx:if="{{canConfirmAgain}}" class="secondary" disabled="{{busy}}" loading="{{busy}}" bindtap="retryConfirmation">重试保存授权结果</button>
    <text wx:if="{{notice}}" class="action-notice">{{notice}}</text><text wx:if="{{actionError}}" class="action-error">{{actionError}}</text>
  </view>
  <view wx:if="{{reminders.length}}" class="reminder-list"><text class="section-title">我的提醒</text><view wx:for="{{reminders}}" wx:key="id" class="card reminder-row"><view><text class="reminder-name">{{item.location_name}}</text><text class="muted">{{item.scheduled_label}}</text><text class="reminder-state">{{item.state_label}}</text></view><button wx:if="{{item.can_cancel}}" class="text-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="cancelReminder">取消</button></view></view>
</view>
