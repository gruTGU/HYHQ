<view style="{{themeStyle}}" class="page theme-{{themeId}} weather-page">
  <view class="page-heading">天气预报与预约</view>
  <view class="city-controls">
    <picker wx:if="{{locations.length}}" class="city-picker" range="{{locations}}" range-key="name" value="{{locationIndex}}" disabled="{{busy || locating || canConfirmAgain || intent}}" bindchange="changeLocation"><view class="location-picker" hover-class="pressable"><view><text class="eyebrow">天气城市</text><text class="location-name">{{location.name}}</text></view><text class="picker-arrow">⌄</text></view></picker>
    <button class="locate-button" hover-class="pressable" disabled="{{busy || loading || locating || canConfirmAgain || intent}}" loading="{{locating}}" bindtap="locateCity">定位城市</button>
  </view>
  <text wx:if="{{locationNotice}}" class="location-notice">{{locationNotice}}</text>
  <page-state loading="{{loading}}" error="{{error}}" bind:retry="load" />
  <view wx:if="{{!loading && !forecastEnabled}}" class="card empty-card"><text class="section-title">天气预报暂未开放</text><text class="muted">首页仍可查看已接入地点的天气、空气质量与预警。</text></view>
  <view wx:elif="{{!loading && forecast && !forecast.available}}" class="card empty-card"><text class="section-title">暂时没有可用预报</text><text class="muted">稍后下拉刷新，再安排这趟出行。</text></view>
  <view wx:if="{{forecast.available}}" class="forecast-section">
    <view class="section-heading"><text class="section-title">接下来三天</text><text class="status {{forecast.stale ? 'status-stale' : ''}}">{{forecast.status_label}}</text></view>
    <view class="forecast-grid"><view wx:for="{{forecast.days}}" wx:key="starts_at" class="forecast-day"><text class="day-date">{{item.date_label}}</text><text class="condition">{{item.condition_label}}</text><text class="temperature">{{item.temperature_label}}</text><text class="forecast-meta">降水 {{item.rain_label}}</text><text class="forecast-meta">{{item.wind_label}}</text><text class="forecast-meta">夜间 {{item.night_label}}</text><text wx:for="{{item.tips}}" wx:for-item="tip" wx:key="*this" class="forecast-tip">{{tip}}</text></view></view>
    <view class="source-footer"><button class="text-button" bindtap="copySource">{{forecast.source_label}} · 数据来源</button><button wx:for="{{forecast.attribution_links}}" wx:key="url" class="text-button" data-url="{{item.url}}" bindtap="copyForecastSource">{{item.label}}</button><text wx:if="{{forecast.attribution}}" user-select="true">{{forecast.attribution}}</text></view>
  </view>
  <view class="card reminder-card">
    <view class="section-heading"><text class="section-title">预约天气提醒</text><text class="once-tag">仅本次</text></view>
    <text class="muted">{{subscriptionNotice || '天气预约暂未开放。'}}</text>
    <block wx:if="{{subscriptionEnabled}}">
      <button wx:if="{{!loggedIn || !wechatLogin}}" class="secondary" hover-class="pressable" bindtap="login">使用微信登录后预约</button>
      <block wx:else>
        <view class="ai-composer"><view class="ai-heading"><text class="intent-title">用一句话安排</text><text class="model-label">DeepSeek Flash</text></view><textarea class="ai-input" value="{{aiText}}" maxlength="500" auto-height="true" disabled="{{busy || canConfirmAgain || intent}}" placeholder="例如：明天早上八点提醒我看天津天气" bindinput="inputAiText" /><button class="ai-button" hover-class="pressable" disabled="{{busy || loading || !location || canConfirmAgain || intent}}" loading="{{aiBusy}}" bindtap="interpretReminder">{{aiBusy ? '正在理解…' : '生成预约草稿'}}</button><text wx:if="{{aiNotice}}" class="action-notice">{{aiNotice}}</text><text wx:if="{{aiError}}" class="action-error">{{aiError}}</text></view>
        <text class="form-caption">手动选择或修改 · 北京时间</text>
        <view class="booking-fields"><picker mode="date" value="{{bookingDate}}" start="{{minDate}}" end="{{maxDate}}" disabled="{{busy || canConfirmAgain || intent}}" bindchange="changeBookingDate"><view class="field" hover-class="pressable"><text class="field-label">预约日期</text><text>{{bookingDate || '选择日期'}} ⌄</text></view></picker><picker mode="time" value="{{bookingTime}}" disabled="{{busy || canConfirmAgain || intent}}" bindchange="changeBookingTime"><view class="field" hover-class="pressable"><text class="field-label">预约时间</text><text>{{bookingTime}} ⌄</text></view></picker></view>
        <text class="booking-help">未来 48 小时内，至少提前 5 分钟。发送可能比预约时间稍晚；不会自动每天重复。</text>
        <button wx:if="{{!intent && !canConfirmAgain}}" class="primary" hover-class="pressable" disabled="{{busy || loading || !location}}" loading="{{busy && !aiBusy}}" bindtap="prepareReminder">核对预约</button>
      </block>
    </block>
    <view wx:if="{{intent}}" class="intent-panel"><text class="intent-title">{{intent.location_name}} · 天气预约提醒</text><text class="muted">{{intent.scheduled_label}}</text><text wx:if="{{intent.expiry_label}}" class="booking-help">预约有效期至 {{intent.expiry_label}}</text><text class="booking-help">确认后由微信弹出订阅选择，同意后才会保存这次提醒。</text><button wx:if="{{!canConfirmAgain}}" class="primary" hover-class="pressable" disabled="{{busy}}" loading="{{busy}}" bindtap="authorizeReminder">确认并订阅本次提醒</button><button wx:if="{{!canConfirmAgain}}" class="text-button" disabled="{{busy}}" bindtap="editReminder">修改预约</button></view>
    <button wx:if="{{canConfirmAgain}}" class="secondary" disabled="{{busy}}" loading="{{busy}}" bindtap="retryConfirmation">重试保存授权结果</button>
    <text wx:if="{{notice}}" class="action-notice">{{notice}}</text><text wx:if="{{actionError}}" class="action-error">{{actionError}}</text>
  </view>
  <view wx:if="{{reminders.length}}" class="reminder-list"><text class="section-title">我的预约</text><view wx:for="{{reminders}}" wx:key="id" class="card reminder-row"><view><text class="reminder-name">{{item.location_name}}</text><text class="muted">{{item.scheduled_label}}</text><text class="reminder-state">{{item.state_label}}</text><text wx:if="{{item.state === 'unknown'}}" class="booking-help">发送结果尚未核实，请先查看微信服务通知。</text></view><button wx:if="{{item.can_cancel}}" class="text-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="cancelReminder">取消</button></view></view>
</view>
