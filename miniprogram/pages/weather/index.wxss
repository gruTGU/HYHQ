.weather-page{color:var(--hyhq-text,#2c3e33);padding-bottom:64rpx}.eyebrow{display:block;font-size:19rpx;letter-spacing:3rpx;color:var(--hyhq-primary,#3a7d5c);margin-bottom:8rpx}.muted{display:block;color:var(--hyhq-muted,#647568);font-size:24rpx;line-height:1.7}.city-controls{display:flex;align-items:stretch;gap:14rpx;margin-bottom:22rpx}.city-picker{flex:1;min-width:0}.location-picker{display:flex;justify-content:space-between;align-items:center;background:var(--hyhq-surface,#fffdf7);border-radius:26rpx;padding:20rpx 24rpx;height:100%;box-sizing:border-box}.location-name{font-size:30rpx;font-weight:600}.picker-arrow{font-size:36rpx;color:var(--hyhq-primary,#3a7d5c)}.locate-button{display:flex;align-items:center;justify-content:center;width:154rpx;margin:0;padding:0 14rpx;background:var(--hyhq-secondary,#e7efdf);color:var(--hyhq-primary,#3a7d5c);font-size:24rpx;border-radius:26rpx;line-height:1.5}.location-notice{display:block;margin:0 6rpx 20rpx;color:var(--hyhq-muted,#647568);font-size:23rpx;line-height:1.6}.card{background:var(--hyhq-surface,#fffdf7);border:1rpx solid var(--hyhq-border,#e0e8da);border-radius:32rpx;padding:28rpx;margin:20rpx 0}.empty-card{padding:40rpx 28rpx}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:16rpx}.section-title{display:block;font-size:31rpx;font-weight:600;margin-bottom:16rpx}.section-heading .section-title{margin:0}.status{color:var(--hyhq-primary,#3a7d5c);font-size:20rpx}.status-stale{color:var(--hyhq-warning,#af633e)}.forecast-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}.forecast-day{min-width:0;background:var(--hyhq-surface,#fffdf7);border:1rpx solid var(--hyhq-border,#e0e8da);border-radius:26rpx;padding:24rpx 16rpx}.day-date{display:block;font-size:21rpx;color:var(--hyhq-muted,#657360)}.temperature{display:block;font-size:26rpx;font-weight:600;margin:14rpx 0;white-space:nowrap}.condition{display:block;font-size:30rpx;line-height:1.5;margin:18rpx 0 6rpx;color:var(--hyhq-primary,#3a7d5c)}.forecast-meta{display:block;font-size:20rpx;line-height:1.7;color:var(--hyhq-muted,#647568);overflow-wrap:anywhere}.forecast-tip{display:block;font-size:20rpx;line-height:1.6;color:var(--hyhq-primary,#3a7d5c);padding-top:14rpx;margin-top:12rpx;border-top:1rpx solid var(--hyhq-border,#e0e8da)}.source-footer{font-size:19rpx;line-height:1.6;color:var(--hyhq-muted,#70816e);padding:4rpx 4rpx 10rpx;overflow-wrap:anywhere}.source-footer text{display:block}.text-button{margin:8rpx 0 0;padding:8rpx 0;line-height:1.4;background:transparent;color:var(--hyhq-primary,#3a7d5c);font-size:24rpx;text-align:left;border:0}.source-footer .text-button{font-size:20rpx}.text-button::after,.locate-button::after,.ai-button::after{border:0}.primary,.secondary{margin-top:26rpx;border-radius:24rpx;font-size:28rpx}.primary{background:var(--hyhq-primary,#3a7d5c);color:#fffdf7}.secondary{background:var(--hyhq-secondary,#e7efdf);color:var(--hyhq-primary,#3a7d5c)}.once-tag{background:var(--hyhq-secondary,#e7efdf);color:var(--hyhq-primary,#3a7d5c);font-size:20rpx;padding:6rpx 14rpx;border-radius:20rpx;white-space:nowrap}.ai-composer{background:var(--hyhq-secondary,#edf3e8);border-radius:26rpx;padding:22rpx;margin-top:22rpx}.ai-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.ai-heading .intent-title{font-size:25rpx;margin:0}.model-label{font-size:19rpx;letter-spacing:.5rpx;color:var(--hyhq-primary,#3a7d5c)}.ai-input{box-sizing:border-box;width:100%;min-height:115rpx;max-height:240rpx;padding:20rpx 0;font-size:25rpx;line-height:1.7;color:var(--hyhq-text,#2c3e33)}.ai-button{background:var(--hyhq-surface,#fffdf7);color:var(--hyhq-primary,#3a7d5c);font-size:24rpx;border-radius:20rpx;line-height:2.1;margin:4rpx 0 0}.form-caption{display:block;margin:24rpx 0 14rpx;font-size:23rpx;font-weight:500}.booking-fields{display:grid;grid-template-columns:1.5fr 1fr;gap:14rpx}.field{background:var(--hyhq-background,#f0f4ed);padding:18rpx 20rpx;border-radius:22rpx;font-size:25rpx;line-height:1.6}.field-label{display:block;font-size:20rpx;color:var(--hyhq-muted,#647568);margin-bottom:8rpx}.booking-help{display:block;margin-top:14rpx;font-size:21rpx;line-height:1.7;color:var(--hyhq-muted,#647568)}.intent-panel{margin-top:24rpx;border-radius:24rpx;background:var(--hyhq-secondary,#edf3e8);padding:24rpx}.intent-title,.reminder-name{display:block;font-size:28rpx;font-weight:600;margin-bottom:8rpx}.action-notice,.action-error{display:block;font-size:24rpx;line-height:1.7;margin-top:20rpx}.action-notice{color:var(--hyhq-primary,#3a7d5c)}.action-error{color:var(--hyhq-warning,#ac5a38)}.reminder-list{margin-top:36rpx}.reminder-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.reminder-row>view{min-width:0;flex:1}.reminder-state{display:block;color:var(--hyhq-primary,#3a7d5c);font-size:23rpx;margin-top:10rpx}.reminder-row .text-button{margin:0;min-width:70rpx;text-align:center}.pressable{transform:scale(.97)}
