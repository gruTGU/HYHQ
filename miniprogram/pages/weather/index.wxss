.weather-page{background:#f0f4ed;color:#2c3e33;padding-bottom:64rpx}.weather-heading{padding:16rpx 4rpx 36rpx}.eyebrow{display:block;font-size:19rpx;letter-spacing:3rpx;color:#3a7d5c;margin-bottom:12rpx}.page-title{display:block;font-size:43rpx;font-weight:600;line-height:1.5;margin-bottom:12rpx}.muted{display:block;color:#647568;font-size:25rpx;line-height:1.7}.location-picker{display:flex;justify-content:space-between;align-items:center;background:#fffdf7;border-radius:28rpx;padding:24rpx 28rpx}.location-name{font-size:32rpx;font-weight:600}.picker-arrow{font-size:38rpx;color:#3a7d5c}.scope-note{display:block;padding:16rpx 6rpx 24rpx;color:#71816f;line-height:1.6;font-size:22rpx}.card{background:#fffdf7;border:1rpx solid #e0e8da;border-radius:32rpx;padding:28rpx;margin:20rpx 0}.empty-card{padding:40rpx 28rpx}.section-heading,.forecast-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.section-title{display:block;font-size:31rpx;font-weight:600;margin-bottom:16rpx}.section-heading .section-title{margin:0}.status{color:#3a7d5c;font-size:22rpx}.status-stale{color:#af633e}.day-date{font-size:26rpx;color:#657360}.temperature{font-size:33rpx;font-weight:600}.condition{display:block;font-size:35rpx;margin:28rpx 0;color:#3a7d5c}.forecast-meta{display:flex;flex-wrap:wrap;gap:12rpx 28rpx;font-size:23rpx;color:#647568}.source-footer{font-size:21rpx;line-height:1.6;color:#70816e;padding:0 10rpx 16rpx;overflow-wrap:anywhere}.source-footer text{display:block}.text-button{margin:8rpx 0 0;padding:8rpx 0;line-height:1.4;background:transparent;color:#3a7d5c;font-size:24rpx;text-align:left;border:0}.text-button::after{border:0}.primary,.secondary{margin-top:26rpx;border-radius:24rpx;font-size:28rpx}.primary{background:#3a7d5c;color:#fffdf7}.secondary{background:#e7efdf;color:#3a7d5c}.intent-panel{margin-top:24rpx;border-radius:24rpx;background:#edf3e8;padding:24rpx}.intent-title,.reminder-name{display:block;font-size:28rpx;font-weight:600;margin-bottom:8rpx}.action-notice,.action-error{display:block;font-size:24rpx;line-height:1.7;margin-top:20rpx}.action-notice{color:#3a7d5c}.action-error{color:#ac5a38}.reminder-list{margin-top:36rpx}.reminder-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.reminder-state{display:block;color:#3a7d5c;font-size:23rpx;margin-top:10rpx}.reminder-row .text-button{margin:0;min-width:70rpx;text-align:center}.pressable{transform:scale(.97)}
