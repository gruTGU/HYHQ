.measurement-heading { position: relative; padding: 12rpx 0 4rpx; overflow: hidden; }.measurement-heading .page-title { font-size: 44rpx; position: relative; z-index: 1; }.measurement-heading .subtitle { font-size: 24rpx; position: relative; z-index: 1; }.river-line { position: absolute; width: 190rpx; height: 80rpx; right: -55rpx; top: 8rpx; border: 12rpx solid #d9e5dc; border-radius: 50%; transform: rotate(-25deg); }
.learning-note { padding: 23rpx 25rpx; border-radius: 24rpx; background: #e4eedf; color: #65805b; font-size: 22rpx; line-height: 1.8; margin-top: 26rpx; }.learning-badge { display: inline-block; color: #3a7d5c; font-weight: 600; font-size: 22rpx; margin-bottom: 8rpx; }
.filters { padding: 28rpx; border: 1rpx solid #e0e8d9; }.filters .section-title { font-size: 29rpx; }.filter-hint { color: #89967d; font-size: 21rpx; }.filter-grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }.filter { width: calc(50% - 16rpx); margin: 18rpx 8rpx 0; min-width: 0; }.filter.wide { width: calc(100% - 16rpx); }.filter .field-label { font-size: 22rpx; margin-bottom: 10rpx; }.picker-value { min-height: 80rpx; padding: 18rpx 20rpx; background: #eef3e8; border-radius: 20rpx; font-size: 25rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.picker-value text { color: #7d9475; flex-shrink: 0; }.picker-value .picker-label { color: #3f5d43; flex: 1; min-width: 0; word-break: break-all; }.compact { font-size: 22rpx; }.advanced-toggle { width: 100%; margin-top: 24rpx; padding: 22rpx 0 0; border-top: 1rpx solid #e3eadb; background: transparent; border-radius: 0; font-size: 24rpx; line-height: 1.8; color: #3a7d5c; }.advanced-toggle text:last-child { font-size: 21rpx; color: #6f8664; }.source-summary { margin-top: 12rpx; color: #78896e; font-size: 21rpx; line-height: 1.8; word-break: break-all; }.advanced-content { padding-bottom: 2rpx; }.filter-explanation { color: #85927b; margin-top: 22rpx; font-size: 21rpx; line-height: 1.8; }
.observation-heading { margin-bottom: 24rpx; }.observation-heading .section-head { margin-bottom: 8rpx; }.observation-heading .section-title { font-size: 30rpx; }.observation-heading .small { font-size: 22rpx; }.measurement-metrics { margin-top: 0; }.metric { border: 2rpx solid transparent; padding: 22rpx; border-radius: 28rpx; }.metric-active { background: #e5efde; border-color: #a8c99b; }.metric-label { font-size: 23rpx; color: #657d5c; }.metric-dot { width: 10rpx; height: 10rpx; background: #3a7d5c; border-radius: 50%; flex-shrink: 0; }.metric-value { font-size: 40rpx; color: #3a7d5c; margin: 10rpx 0; overflow-wrap: anywhere; }.metric .small { font-size: 21rpx; }.unit { font-size: 20rpx; font-weight: 400; }.timestamp { font-size: 19rpx; color: #89947e; margin-top: 7rpx; word-break: break-all; }
.trend-card { border: 1rpx solid #e1e8db; }.trend-card .section-title { font-size: 30rpx; }.trend-picker { margin-top: 22rpx; background: #eef3e8; }.stats { display: flex; justify-content: space-between; gap: 14rpx; margin: 24rpx 0 18rpx; }.stats > view { flex: 1; min-width: 0; background: #f0f4e9; border-radius: 20rpx; padding: 18rpx 14rpx; text-align: center; }.stats text { color: #7c8c70; font-size: 22rpx; }.stats view view { font-size: 29rpx; color: #3a7d5c; font-weight: 550; margin-top: 3rpx; overflow-wrap: anywhere; }.quality-line { display: flex; flex-wrap: wrap; gap: 18rpx; color: #8a957f; font-size: 21rpx; }.quality-valid { color: #4f7e58; }.provenance { background: #f9fbf5; border: 1rpx solid #dce5d6; }.provenance-toggle { width: 100%; background: transparent; padding: 0; color: #6f8564; line-height: 1.8; font-size: 22rpx; text-align: left; }.provenance-toggle .title { color: #466448; font-size: 26rpx; }.window-summary { color: #7e8d74; font-size: 20rpx; margin-top: 5rpx; }.provenance-detail { margin-top: 18rpx; padding-top: 12rpx; border-top: 1rpx solid #e2eadb; }.provenance-detail .copy { font-size: 22rpx; }.break-word { word-break: break-all; }
