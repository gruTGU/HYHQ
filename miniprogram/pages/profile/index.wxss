.profile-page { padding-top: 0; }
.profile-header { position: relative; overflow: hidden; margin: 0 -32rpx; padding: 24rpx 36rpx 40rpx; border-radius: 0 0 76rpx 76rpx; background: #3a7d5c; color: #fff; }
.profile-header::after { content: ''; position: absolute; width: 220rpx; height: 220rpx; right: -82rpx; bottom: -124rpx; border: 30rpx solid rgba(168, 201, 155, .22); border-radius: 50%; pointer-events: none; }
.profile-brand { display: flex; align-items: center; justify-content: space-between; }
.profile-heading { font-size: 34rpx; font-weight: 600; margin-top: 7rpx; }
.profile-brand-mark { flex-shrink: 0; width: 84rpx; height: 84rpx; padding: 4rpx; margin-left: 20rpx; border-radius: 22rpx; background: #fff; }
.brand-logo { display: block; width: 100%; height: 100%; border-radius: 18rpx; }
.profile-identity { display: flex; align-items: center; margin-top: 24rpx; }
.profile-name { font-size: 37rpx; line-height: 1.4; font-weight: 600; word-break: break-all; }
.profile-test { display: inline-block; margin-top: 8rpx; border: 1rpx solid #a8c99b; padding: 2rpx 12rpx; border-radius: 20rpx; color: #e5efe0; font-size: 20rpx; }
.profile-content { position: relative; margin-top: 28rpx; }
.card { background: var(--hyhq-surface, #fffefa); border-radius: var(--hyhq-card-radius, 32rpx); }
.login-card { padding: 34rpx; }
.login-notice { display: flex; align-items: center; flex-wrap: nowrap; gap: 0; white-space: nowrap; font-size: 22rpx; line-height: 1.5; margin: 26rpx 0 8rpx; color: #718278; }
.legal-link { color: #3a7d5c; text-decoration: underline; }
.avatar-frame { box-sizing: border-box; flex: 0 0 120rpx; width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; margin-right: 24rpx; border: 6rpx solid rgba(255, 255, 255, .8); background: #e5efdf; overflow: hidden; }
.avatar { display: block; width: 108rpx; height: 108rpx; flex-shrink: 0; border-radius: 50%; overflow: hidden; }
.avatar-placeholder { position: relative; width: 108rpx; height: 108rpx; border-radius: 50%; overflow: hidden; }
.avatar-head { position: absolute; left: 36rpx; top: 20rpx; width: 36rpx; height: 36rpx; background: #7ca58d; border-radius: 50%; }
.avatar-shoulders { position: absolute; left: 21rpx; bottom: 7rpx; width: 66rpx; height: 42rpx; background: #7ca58d; border-radius: 40rpx 40rpx 14rpx 14rpx; }
.record-grid { display: flex; flex-wrap: nowrap; align-items: stretch; background: #fff; border-radius: 32rpx; padding: 18rpx 6rpx; }
.record-entry { flex: 1 1 0; min-width: 0; width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 18rpx 0; border-radius: 18rpx; background: transparent; font-size: 21rpx; line-height: 1.6; color: #2c3e33; font-weight: 400; white-space: nowrap; }
.record-entry:active { background: #f0f4ed; }
.record-icon { position: relative; width: 48rpx; height: 48rpx; margin: 0 0 16rpx; color: #3a7d5c; }
