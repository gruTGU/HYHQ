.menu-card { padding: 0 28rpx; overflow: hidden; }
.menu-row { box-sizing: border-box; display: flex; align-items: center; gap: 16rpx; min-height: 100rpx; padding: 22rpx 0; }
.profile-page .menu-card .setting-button { width: 100%; margin: 0; border-radius: 0; background: transparent; color: var(--hyhq-text, #2c3e33); font-size: 28rpx; line-height: 1.6; text-align: left; font-weight: 400; }
.menu-card .setting-button + .setting-button, .history-setting + .setting-button { border-top: 1rpx solid var(--hyhq-border, #dbe5d6); }
.setting-label { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.6; white-space: nowrap; }
.setting-value { flex: 0 1 auto; max-width: 42%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--hyhq-muted, #65796c); font-size: 24rpx; }
.menu-row .chevron { flex: 0 0 20rpx; margin: 0; text-align: right; line-height: 1; color: var(--hyhq-muted, #65796c); }
.profile-editor { margin-bottom: 28rpx; }
.editor-avatar-row { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; }
.editor-avatar-note, .avatar-notice { color: var(--hyhq-muted, #65796c); font-size: 24rpx; line-height: 1.6; }
.avatar-notice { margin-bottom: 24rpx; }
.privacy-card switch { flex: none; margin-left: 0; transform: scale(.9); transform-origin: right center; }
.history-setting .menu-row { padding-bottom: 12rpx; }
.setting-help { padding-bottom: 24rpx; color: var(--hyhq-muted, #65796c); font-size: 24rpx; line-height: 1.6; }
.account-actions { margin-top: 30rpx; }
.profile-page .account-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; padding: 20rpx 22rpx; line-height: 1.5; text-align: center; }
.profile-page .privacy-card .account-delete { color: #b46237; }

.profile-page .profile-edit-link { display: inline-block; width: auto; padding: 4rpx 0; margin: 8rpx 0 0; background: transparent; color: #e5efe0; font-weight: 400; font-size: 23rpx; line-height: 1.6; text-align: left; }
.profile-edit-chevron { display: inline-block; margin-left: 12rpx; transition: transform .18s; }
.chevron-open { transform: rotate(90deg); }
.login-notice checkbox-group { flex: none; }
.agreement-label { display: flex; align-items: center; min-height: 56rpx; white-space: nowrap; }
.agreement-label checkbox { flex: 0 0 42rpx; width: 42rpx; margin-right: 4rpx; transform: scale(.7); transform-origin: left center; }
.agreement-links { display: flex; align-items: center; flex: none; margin-left: 0; white-space: nowrap; }
.profile-page .avatar-edit { width: auto; margin: 0; padding: 15rpx 24rpx; font-size: 25rpx; }
