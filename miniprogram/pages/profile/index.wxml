<view style="{{themeStyle}}" class="page theme-{{themeId}} profile-page">
  <view class="profile-header">
    <view class="profile-brand"><view class="profile-heading">我的</view><view class="profile-brand-mark"><image class="brand-logo" src="/assets/brand/hyhq-logo.jpg" mode="aspectFit" aria-label="海晏河清智慧平台标志" /></view></view>
    <view wx:if="{{!loading && user}}" class="profile-identity">
      <view class="avatar-frame" aria-label="个人头像"><image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" /><view wx:else class="avatar-placeholder"><view class="avatar-head"></view><view class="avatar-shoulders"></view></view></view>
      <view class="grow"><view class="profile-name">{{user.nickname || '绿色生活体验者'}}</view><button hover-class="pressable" class="profile-edit-link" bindtap="toggleProfileEditor" disabled="{{busy}}" aria-expanded="{{editingProfile}}">{{editingProfile ? '收起编辑' : '编辑资料'}}<text class="profile-edit-chevron {{editingProfile ? 'chevron-open' : ''}}">›</text></button><text wx:if="{{authMode === 'development'}}" class="profile-test">测试账号</text></view>
    </view>
  </view>
  <view class="profile-content">
    <page-state loading="{{loading}}" error="{{error && !busy ? error : ''}}" bindretry="load" />
    <view wx:if="{{!loading && !user}}" class="card login-card">
      <view class="title">开启你的绿色记录</view><view class="copy">登录后，可保存收藏与足迹，上传识别图片。</view>
      <view class="login-notice"><checkbox-group bindchange="agreementChange"><label class="agreement-label"><checkbox value="agreed" checked="{{agreed}}" disabled="{{busy}}" color="#3a7d5c" /><text>我已阅读并同意</text></label></checkbox-group><view class="agreement-links"><text class="legal-link" data-kind="terms" bindtap="legal">《用户协议》</text><text>与</text><text class="legal-link" data-kind="privacy" bindtap="legal">《隐私说明》</text></view></view>
      <button hover-class="pressable" class="primary gap" loading="{{busy}}" disabled="{{busy}}" data-mode="wechat" bindtap="login">微信登录</button>
      <button hover-class="pressable" wx:if="{{devAvailable}}" class="secondary gap" loading="{{busy}}" disabled="{{busy}}" data-mode="dev" bindtap="login">测试账号登录</button>
    </view>
    <block wx:if="{{!loading && user}}">
      <form wx:if="{{editingProfile}}" class="card profile-editor" bindsubmit="saveProfile">
        <view class="editor-avatar-row"><button hover-class="pressable" class="secondary avatar-edit" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" binderror="avatarError" disabled="{{busy}}" loading="{{busy}}">更换头像</button><text class="editor-avatar-note">选择后自动保存</text></view>
        <view wx:if="{{avatarNotice}}" class="notice">{{avatarNotice}}</view>
        <view class="field"><text class="field-label">昵称</text><input type="nickname" name="nickname" maxlength="32" value="{{nickname}}" bindinput="nicknameInput" bindnicknamereview="nicknameReview" placeholder="输入昵称或选择微信昵称" disabled="{{busy}}" /></view>
        <view wx:if="{{nicknameNotice}}" class="notice">{{nicknameNotice}}</view>
        <button hover-class="pressable" class="secondary gap" form-type="submit" loading="{{busy}}" disabled="{{busy}}">保存昵称</button>
      </form>
      <view wx:elif="{{avatarNotice}}" class="avatar-notice">{{avatarNotice}}</view>
      <view class="section-head"><text class="section-title">我的记录</text><text class="small muted">仅自己可见</text></view>
      <view class="record-grid">
        <button hover-class="pressable" class="record-entry" data-kind="favorites" bindtap="records"><view class="record-icon icon-favorite"></view><text>我的收藏</text></button>
        <button hover-class="pressable" class="record-entry" data-kind="histories" bindtap="records"><view class="record-icon icon-history"></view><text>浏览记录</text></button>
        <button hover-class="pressable" class="record-entry" data-kind="recognition-jobs" bindtap="records"><view class="record-icon icon-recognition"><text>AI</text></view><text>识别记录</text></button>
        <button hover-class="pressable" class="record-entry" data-kind="assessment-jobs" bindtap="records"><view class="record-icon icon-water"><view></view></view><text>河道观察</text></button>
        <button hover-class="pressable" class="record-entry" data-kind="visits" bindtap="records"><view class="record-icon icon-visit"></view><text>游览足迹</text></button>
        <button hover-class="pressable" class="record-entry" bindtap="aiHistory"><view class="record-icon icon-chat"><text>···</text></view><text>AI 对话</text></button>
      </view>
    </block>
    <view wx:if="{{!loading}}" class="card section menu-card">
      <button hover-class="pressable" wx:if="{{user && cloudMode}}" class="setting-button menu-row" bindtap="submissions"><text class="setting-label">我的投稿</text><text class="chevron">›</text></button>
      <button hover-class="pressable" class="setting-button menu-row" bindtap="openThemeSettings"><text class="setting-label">外观与主题</text><text class="setting-value">{{themeName}}</text><text class="chevron">›</text></button>
      <button hover-class="pressable" class="setting-button menu-row" bindtap="feedback"><text class="setting-label">意见与反馈</text><text class="chevron">›</text></button>
      <button hover-class="pressable" wx:if="{{user && canManage}}" class="setting-button menu-row" bindtap="management"><text class="setting-label">平台管理</text><text class="chevron">›</text></button>
    </view>
    <block wx:if="{{!loading}}">
      <view class="section-head section"><text class="section-title">{{user ? '隐私与账号' : '协议与隐私'}}</text></view>
      <view class="card menu-card privacy-card">
        <view wx:if="{{user}}" class="history-setting">
          <view class="menu-row"><text class="setting-label">保存浏览记录</text><switch checked="{{user.record_history}}" disabled="{{busy}}" color="#3a7d5c" bindchange="privacyChange" aria-label="保存浏览记录" /></view>
          <view class="setting-help">关闭后不再新增，已有记录可自行删除</view>
        </view>
        <button hover-class="pressable" class="setting-button menu-row" data-kind="privacy" bindtap="legal"><text class="setting-label">隐私说明</text><text class="chevron">›</text></button>
        <button hover-class="pressable" class="setting-button menu-row" data-kind="terms" bindtap="legal"><text class="setting-label">用户协议</text><text class="chevron">›</text></button>
      </view>
    </block>
    <view wx:if="{{!loading && user}}" class="account-actions"><button hover-class="pressable" class="secondary" disabled="{{busy}}" bindtap="logout">退出登录</button><button hover-class="pressable" class="text-button account-delete" disabled="{{busy}}" bindtap="deleteAccount">注销账号</button></view>
    <view class="footer-note">每一份绿色记忆，都由你掌握</view>
  </view>
</view>
