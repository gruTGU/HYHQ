<view style="{{themeStyle}};{{themeAssetStyle}}" class="page theme-{{themeId}} {{themeId !== 'forest' ? 'theme-designed' : ''}} recognition-page">

  <view class="observe-tabs"><button class="observe-tab {{mode === 'recognition' ? 'active' : ''}}" disabled="{{busy || riverBusy}}" data-mode="recognition" bindtap="changeMode" aria-pressed="{{mode === 'recognition'}}"><image class="observe-tab-icon" src="/assets/icons/observe-flower.png" mode="aspectFit" />花卉识别</button><button class="observe-tab {{mode === 'assessment' ? 'active' : ''}}" disabled="{{busy || riverBusy}}" data-mode="assessment" bindtap="changeMode" aria-pressed="{{mode === 'assessment'}}"><image class="observe-tab-icon" src="/assets/icons/observe-river.png" mode="aspectFit" />河道观察</button></view>
  <river-observer wx:if="{{mode === 'assessment'}}" id="river-observer" bindbusychange="riverBusyChange" />
  <block wx:else>
  <view class="flow-steps"><view class="flow-step {{!imagePath ? 'current' : 'done'}}"><text class="step-number">1</text><text>选择照片</text></view><view class="step-line"></view><view class="flow-step {{imagePath && !task.result_view ? 'current' : ''}}"><text class="step-number">2</text><text>开始识别</text></view><view class="step-line"></view><view class="flow-step {{task.result_view ? 'current' : ''}}"><text class="step-number">3</text><text>认识花卉</text></view></view>
  <view class="notice" wx:if="{{capabilityKnown && !capability.enabled}}">花卉识别暂未开放，已保存的识别记录仍可查看。</view>
  <view class="error-inline" wx:if="{{capabilityError}}">{{capabilityError}}</view>
  <view class="upload-panel section">
    <block wx:if="{{imagePath}}"><image class="preview" src="{{imagePath}}" mode="aspectFit" /><button class="replace" disabled="{{busy}}" bindtap="choose">重新选择照片</button></block>
    <block wx:else><button class="leaf-camera" hover-class="leaf-camera-pressed" bindtap="choose" disabled="{{busy}}" aria-label="拍照或从相册选择花卉照片"><image class="camera-icon" src="/assets/icons/observe-camera.png" mode="aspectFit" /><text class="camera-label">拍照 / 选图</text></button><view class="title upload-title">让花朵成为画面的主角</view></block>
  </view>
  <view class="small muted gap" wx:if="{{imageUnavailable}}">{{imageUnavailable}}</view>
  <view wx:if="{{!loggedIn}}" class="gap"><button class="primary" bindtap="login">登录，开启自然观察</button><view class="small muted centered gap">登录后可保存和查看自己的识别记录。</view></view>
  <block wx:else><button wx:if="{{imageOrigin !== 'history' && !task.result_view}}" class="primary gap flower-submit" disabled="{{busy || !capabilityKnown || !capability.enabled || !imagePath || task.status === 'queued' || task.status === 'running'}}" loading="{{busy}}" bindtap="submit">{{busy ? '正在上传照片' : task.status === 'queued' || task.status === 'running' ? '正在识别这朵花' : '开始识别'}}</button><view class="small muted centered gap"><text class="privacy-link" bindtap="privacy">隐私与图片保留声明</text></view></block>
  <view class="scope-card section"><view class="title">当前支持五类花卉，结果供观察参考</view><view class="copy gap">目前只支持以下五类常见花卉的识别。这是一项轻量的图片分类功能，帮你初步认识身边的花草，并非专业植物鉴定。如果拍到五类之外的植物，系统仍可能给出一个“最像”的候选——这属于正常现象，请把结果当作初步参考，并与实物对比确认。</view><view class="scope-labels"><text>雏菊类</text><text>郁金香类</text><text>蒲公英类</text><text>蔷薇属</text><text>向日葵类</text></view><view class="small muted gap">识别模型为 {{capability.modelName || 'flowers-efficientnet-b0'}} · {{capability.modelVersion || 'v1'}}</view></view>
  <view class="card section task-card" wx:if="{{task && !task.result_view}}"><view class="row"><text class="title">{{task.status_label}}</text><view wx:if="{{task.status === 'queued' || task.status === 'running'}}" class="loading-leaf"></view></view><view class="copy">{{task.error_label || (task.status === 'queued' ? '照片已收到，正在等候识别。' : task.status === 'running' ? '正在观察花瓣与叶片，请稍候。' : '本次未获得可展示的识别结果。')}}</view><view class="small muted gap">{{task.created_label}}</view><button class="secondary gap" bindtap="refreshTask">刷新结果</button></view>
  <recognition-result wx:if="{{task && task.result_view}}" result="{{task.result_view}}" bindcontent="openContent" bindretake="choose" />
  <view wx:if="{{task.result_view}}" class="card section ai-next"><view class="row"><view><text class="ai-model">✦ DeepSeek Flash</text><view class="title gap">听听这朵花的故事</view></view><text class="ai-orbit">AI</text></view><view class="copy">核对候选特征，了解更多植物知识。原图可由你主动选择附带。</view><button class="secondary gap" bindtap="openAI" disabled="{{busy}}">问问 AI</button></view>
  <page-state appearance="{{themeId || 'forest'}}" empty-image="{{themeAssets.emptyState || ''}}" loading="{{loading}}" error="{{error}}" bindretry="refreshTask" />
  <view class="section" wx:if="{{jobs.length}}"><view class="section-head"><text class="section-title">最近的发现</text></view><view class="card history-row" wx:for="{{jobs}}" wx:key="id" data-id="{{item.id}}" bindtap="openJob"><image class="record-symbol" src="/assets/icons/observe-flower.png" mode="aspectFit" /><view class="grow"><view class="title">{{item.result_view ? item.result_view.heading : item.status_label}}</view><view class="copy" wx:if="{{item.error_label}}">{{item.error_label}}</view><view class="small muted gap">{{item.created_label}}</view></view><text class="chevron">›</text></view></view>
  </block>
</view>
