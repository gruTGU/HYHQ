@import "../../styles/observation-ui.wxss";
.observe-tabs { display: flex; margin: 0 0 24rpx; padding: 8rpx; background: #e2ecde; border-radius: 24rpx; }
.observe-tabs .observe-tab { flex: 1; width: 50%; min-width: 0; min-height: 72rpx; display: flex; align-items: center; justify-content: center; text-align: center; color: #687e6d; background: transparent; font-size: 26rpx; font-weight: 400; line-height: 1.5; padding: 18rpx 0; border-radius: 19rpx; }
.observe-tab.active { background: #fffefa; color: #3a7d5c; font-weight: 600; box-shadow: 0 4rpx 12rpx rgba(44,62,51,.04); }
.observe-tab text { margin-left: 12rpx; }
.preview { width: 100%; height: 490rpx; }
.scope-card { padding: 26rpx; background: #eaf0e5; border-radius: 26rpx; }
.help-toggle { flex-shrink: 0; color: #3a7d5c; font-size: 23rpx; margin-left: 16rpx; }
.scope-labels { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.scope-labels text { background: #fffefa; color: #3a7d5c; padding: 8rpx 16rpx; border-radius: 99rpx; font-size: 22rpx; margin: 8rpx 10rpx 0 0; }

.observe-tab-icon { width: 35rpx; height: 35rpx; margin-right: 12rpx; }
