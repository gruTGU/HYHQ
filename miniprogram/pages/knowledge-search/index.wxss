.search-row { display: flex; align-items: center; gap: 16rpx; }.search-row input { flex: 1; min-width: 0; height: 80rpx; font-size: 26rpx; }.search-row button { margin: 0; padding: 0 24rpx; flex-shrink: 0; }.filter-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.selector { background: #f0f4ed; padding: 18rpx; border-radius: 16rpx; font-size: 24rpx; }.excerpt { display: block; margin-top: 20rpx; line-height: 1.9; color: #425649; font-size: 28rpx; white-space: pre-wrap; }.source { overflow-wrap: anywhere; word-break: break-all; }.row { gap: 12rpx; }
