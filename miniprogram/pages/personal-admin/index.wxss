.admin-tabs{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.admin-tabs button{font-size:24rpx;padding:8rpx 20rpx;min-width:0}.admin-row{margin-bottom:20rpx}.admin-row button{margin-top:16rpx}.admin-editor textarea{box-sizing:border-box;width:100%;min-height:140rpx;background:#f0f4ed;border-radius:16rpx;padding:20rpx;margin:16rpx 0}.admin-editor input{background:#f0f4ed;border-radius:16rpx;padding:20rpx;margin:16rpx 0}.admin-metric{white-space:pre-wrap;word-break:break-all;font-size:24rpx;line-height:1.8}.admin-actions{display:flex;gap:12rpx}.admin-actions button{flex:1}.admin-warning{color:#ad5837}
.admin-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;margin:24rpx 0}.admin-cell{padding:20rpx;background:#f0f4ed;border-radius:20rpx}.admin-value{font-size:36rpx;line-height:1.5;font-weight:600;color:#3a7d5c;word-break:break-all}.admin-note{margin:20rpx 0;word-break:break-all}.admin-notice{padding:20rpx;border-radius:18rpx;background:#e8f2e5;color:#3a7d5c;margin:16rpx 0;white-space:pre-wrap}.admin-row-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:16rpx}.admin-status{font-size:24rpx;color:#3a7d5c;flex-shrink:0}.admin-body{white-space:pre-wrap;line-height:1.7;margin:20rpx 0}.admin-picker{padding:20rpx;border-radius:16rpx;background:#f0f4ed;margin:20rpx 0}.admin-labeled{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:20rpx 0;font-size:26rpx}.admin-labeled input{width:130rpx;background:#f0f4ed;border-radius:16rpx;padding:16rpx;text-align:center}.admin-preview{border-top:1rpx solid #e2eade;margin-top:20rpx;padding-top:20rpx}.admin-actions{flex-wrap:wrap}.admin-actions button{min-width:150rpx}
