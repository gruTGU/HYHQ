<view class="page learn-page">
  <text class="eyebrow">NATURE JOURNAL / 科普智游</text>
  <view class="journal-hero">
    <view class="journal-intro"><view class="page-title">读懂自然，<view>再走近一点。</view></view><view class="subtitle">把生态知识，带进日常。</view></view>
    <image class="journal-art" src="/assets/illustrations/botanical-river.jpg" mode="aspectFill" aria-hidden="true" />
  </view>
  <view class="tabs section"><button class="tab {{tab === 'contents' ? 'selected' : ''}}" data-tab="contents" bindtap="changeTab" hover-class="pressable">科普手记</button><button class="tab {{tab === 'routes' ? 'selected' : ''}}" data-tab="routes" bindtap="changeTab" hover-class="pressable">漫步路线</button></view>
  <view class="card filters">
    <view class="filter-top"><picker class="region-picker" range="{{regions}}" range-key="name" value="{{regionIndex}}" bindchange="changeRegion"><view class="region-selector"><text class="region-leaf" aria-hidden="true"></text><text>{{regions[regionIndex].name}}</text><text class="picker-chevron">⌄</text></view></picker><button wx:if="{{tab === 'contents'}}" class="text-button filter-toggle" bindtap="toggleFilters" aria-expanded="{{showFilters}}">{{showFilters ? '收起筛选' : '分类筛选'}}<text wx:if="{{category || plant_label || place}}" class="filter-dot"></text></button></view>
    <view wx:if="{{regionError}}" class="error-inline">区域暂时无法加载：{{regionError}}<button class="text-button" bindtap="load">重新加载</button></view>
    <block wx:if="{{tab === 'contents'}}">
      <view class="search-row"><input value="{{searchInput}}" placeholder="搜索自然知识" maxlength="100" confirm-type="search" bindinput="inputSearch" bindconfirm="searchContents" /><button class="search-button" hover-class="pressable" bindtap="searchContents">搜索</button></view>
      <view wx:if="{{showFilters}}" class="filter-details">
        <view class="filter-grid"><view><text class="field-label">内容分类</text><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="changeCategory"><view class="selector">{{categories[categoryIndex].name}}<text>⌄</text></view></picker></view><view><text class="field-label">植物标签</text><picker range="{{plantLabels}}" range-key="name" value="{{plantIndex}}" bindchange="changePlant"><view class="selector">{{plantLabels[plantIndex].name}}<text>⌄</text></view></picker></view></view>
        <view class="small muted gap">通用科普会随各区域一起显示。</view>
      </view>
      <view wx:if="{{tagsLoading && showFilters}}" class="small muted gap">正在读取可用标签…</view>
      <view wx:if="{{tagsError}}" class="error-inline">标签暂时无法加载：{{tagsError}}<button class="text-button" bindtap="retryTags">重试标签</button></view>
      <view wx:if="{{place}}" class="linked-place gap"><text>正在浏览关联地点的科普</text><button class="text-button" bindtap="clearPlace">清除地点</button></view>
      <view wx:if="{{category || plant_label || search || place}}" class="active-filters"><text class="small muted">{{category ? categories[categoryIndex].name + ' · ' : ''}}{{plant_label ? plantLabels[plantIndex].name + ' · ' : ''}}{{search ? '“' + search + '”' : '已限定内容范围'}}</text><button class="text-button reset" bindtap="resetFilters">清除筛选</button></view>
    </block>
    <view wx:else><view class="copy">依次浏览沿途地点，发现绿色生活的另一面。</view><button wx:if="{{regionId}}" class="text-button gap" bindtap="allRoutes">浏览全部区域路线 ↗</button></view>
  </view>
  <view class="section-head results-head"><text class="section-title">{{tab === 'contents' ? '自然手记' : '慢慢走，看一看'}}</text><text class="small muted">{{tab === 'contents' ? '阅读 · 发现 · 收藏' : '管理员整理'}}</text></view>
  <block wx:if="{{tab === 'contents'}}">
    <page-state loading="{{contentsLoading}}" error="{{contentsError}}" empty="{{!contentsLoading && !contentsError && !contents.length}}" empty-text="暂时没有符合条件的手记，试试清除筛选或切换区域。" bindretry="retryContents" />
    <button wx:if="{{!contentsLoading && !contentsError && !contents.length && (category || plant_label || search || place)}}" class="secondary gap" bindtap="resetFilters">浏览全部科普</button>
    <block wx:if="{{!contentsLoading && !contentsError}}">
      <view class="card article" wx:for="{{contents}}" wx:key="id" data-kind="content" data-id="{{item.id}}" bindtap="open" hover-class="pressable" aria-role="button" aria-label="阅读{{item.title}}">
        <view class="article-top"><text class="article-category">{{item.category_name || '自然见闻'}}</text><text wx:if="{{item.is_demo}}" class="pill">科普示例</text><text class="article-index">{{10 > index + 1 ? '0' + (index + 1) : index + 1}}</text></view>
        <view class="title article-title">{{item.title}}</view><view class="copy article-summary">{{item.summary || '阅读完整科普内容'}}</view>
        <view class="tags" wx:if="{{item.plant_name}}"><text># {{item.plant_name}}</text></view>
        <view wx:if="{{item.place_summary}}" class="small muted gap">{{item.place_summary.name}} · {{item.place_summary.region_name}}</view>
        <view class="article-footer"><text class="article-source">{{item.source || '管理员整理'}}</text><text class="read-link">阅读手记 ↗</text></view>
      </view>
      <view wx:if="{{contents.length}}" class="list-footer"><view wx:if="{{contentsMoreError}}" class="error-inline">{{contentsMoreError}}</view><button wx:if="{{contentsNext}}" class="secondary" loading="{{contentsLoadingMore}}" disabled="{{contentsLoadingMore}}" bindtap="moreContents">{{contentsMoreError ? '重试加载更多' : '加载更多科普'}}</button><text wx:else class="small muted">· 已展示 {{contents.length}} 篇手记 ·</text></view>
    </block>
  </block>
  <block wx:else>
    <page-state loading="{{routesLoading}}" error="{{routesError}}" empty="{{!routesLoading && !routesError && !routes.length}}" empty-text="这个区域暂时没有公开路线，试试切换区域。" bindretry="retryRoutes" />
    <block wx:if="{{!routesLoading && !routesError}}">
      <view class="card route-card" wx:for="{{routes}}" wx:key="id" data-kind="route" data-id="{{item.id}}" bindtap="open" hover-class="pressable" aria-role="button" aria-label="查看{{item.name || item.title}}">
        <view class="route-heading"><view class="route-mark" aria-hidden="true"><view></view><view></view><view></view></view><text class="small muted">{{item.region_name || '公开路线'}}</text><text wx:if="{{item.is_demo}}" class="pill">科普模拟路线</text></view>
        <view class="title gap">{{item.name || item.title}}</view><view class="copy">{{item.description || item.summary || '查看路线节点'}}</view>
        <view class="route-footer"><text class="stop-count">{{item.public_stop_count === null ? '浏览沿途地点' : item.public_stop_count + ' 个公开地点'}}</text><text class="read-link">展开路线 ↗</text></view>
        <view wx:if="{{item.public_stop_count === 0}}" class="small muted gap">沿途地点正在整理中，仍可阅读路线介绍。</view>
        <view wx:if="{{item.source}}" class="small muted source-note">路线来源：{{item.source}}</view>
      </view>
      <view wx:if="{{routes.length}}" class="list-footer"><view wx:if="{{routesMoreError}}" class="error-inline">{{routesMoreError}}</view><button wx:if="{{routesNext}}" class="secondary" loading="{{routesLoadingMore}}" disabled="{{routesLoadingMore}}" bindtap="moreRoutes">{{routesMoreError ? '重试加载更多' : '加载更多路线'}}</button><text wx:else class="small muted">· 共 {{routes.length}} 条公开路线 ·</text></view>
    </block>
  </block>
  <view class="notice">内容由管理员整理，科普示例与模拟路线均有标注。路线供阅读参考，不提供实时导航或到访核验。右下角 AI 可以陪你继续了解当前区域。</view>
  <floating-ai visible="{{!regionError && regions.length > 1}}" tab-page="{{true}}" bindopen="openAI" />
</view>
