@import "../../styles/observation-ui.wxss";
/* Only the widthFix image determines this container's height; captions live outside it. */
.image-wrap { position: relative; overflow: hidden; border-radius: 32rpx; line-height: 0; background: #e5efea; }
.preview { width: 100%; display: block; }
.box-layer { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.detection-box { position: absolute; border: 3rpx solid #e4a45f; }
.box-label { position: absolute; top: 0; left: 0; background: #e4a45f; color: #2c3e33; font-size: 21rpx; line-height: 1.4; padding: 0 6rpx; }
.water-picker { padding: 20rpx; margin-top: 20rpx; border-radius: 18rpx; background: #f0f4ed; font-size: 27rpx; }
.nearby { padding: 22rpx; border-radius: 22rpx; background: #eaf2e7; }
.result-banner { padding: 32rpx; background: linear-gradient(140deg, #e0ecd8, #e8f0ec); border-radius: 32rpx; }
.rule-score { font-size: 76rpx; line-height: 1.4; color: #3a7d5c; font-weight: 650; margin-top: 12rpx; }
.rule-score-unit { font-size: 25rpx; font-weight: 400; }
.detection-row { display: flex; gap: 16rpx; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #e5eddf; font-size: 26rpx; }
.detection-row .small { flex-shrink: 0; }

.observation-metrics { display: flex; text-align: center; }
.observation-metric { flex: 1; padding: 18rpx 8rpx; }
.observation-number { color: #3a7d5c; font-size: 44rpx; font-weight: 600; }
.observation-grid { display: flex; flex-wrap: wrap; border-top: 1rpx solid #d8e3d1; border-left: 1rpx solid #d8e3d1; }
.observation-cell { box-sizing: border-box; width: 33.333333%; min-height: 110rpx; padding: 14rpx; border-right: 1rpx solid #d8e3d1; border-bottom: 1rpx solid #d8e3d1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #758575; font-size: 23rpx; }
.observation-cell-active { background: #eaf2e7; color: #3a7d5c; }
.observation-cell-count { font-size: 30rpx; margin-top: 8rpx; font-weight: 600; }

.help-toggle { color: var(--hyhq-primary, #3a7d5c); font-size: 23rpx; flex-shrink: 0; margin-left: 14rpx; }

.annotation-example-image { display: block; width: 100%; margin: 20rpx 0; border-radius: 18rpx; background: #e5efea; }

.assessment-page .river-submit { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 20rpx 22rpx; line-height: 1.5; text-align: center; }
.assessment-page .history-all { flex: none; width: auto; min-width: 0; margin: 0 0 0 auto; padding: 10rpx 0; display: flex; align-items: center; justify-content: flex-end; text-align: right; line-height: 1.5; }
.river-history-row { display: flex; align-items: center; gap: 16rpx; }
.river-history-details { flex: 1; min-width: 0; }
.river-history-heading { line-height: 1.5; }
.river-history-time { flex: none; margin: 0; line-height: 1.5; text-align: right; white-space: nowrap; font-size: 22rpx; }
