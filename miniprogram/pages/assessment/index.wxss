.observe-kind { display: flex; gap: 12rpx; align-items: center; color: #3a7d5c; font-size: 23rpx; margin-top: 24rpx; }
.kind-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #7fb3c8; }
.kind-note { margin-left: auto; color: #758575; font-size: 21rpx; }
.flow-steps { display: flex; align-items: center; gap: 12rpx; margin: 30rpx 0; color: #7a897a; font-size: 23rpx; }
.flow-steps view { flex: 1; height: 2rpx; background: #d8e3d1; }
.flow-steps .current { color: #3a7d5c; font-weight: 600; }
.scope-card { padding: 24rpx 26rpx; background: #e7eee3; border-radius: 26rpx; }
.help-toggle { color: #3a7d5c; font-size: 23rpx; flex-shrink: 0; margin-left: 14rpx; }
.upload-panel { min-height: 430rpx; padding: 34rpx 28rpx; border: 2rpx solid #d7e5d3; border-radius: 32rpx; background: linear-gradient(145deg, #fafcf6, #e5efea); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.water-illustration { position: relative; width: 232rpx; height: 140rpx; margin-bottom: 24rpx; overflow: hidden; border-radius: 54% 56% 40% 44%; background: #e1eee9; }
.water-bank { position: absolute; width: 230rpx; height: 100rpx; left: -50rpx; bottom: -10rpx; border-radius: 50% 70% 0 0; background: #a8c99b; transform: rotate(-15deg); }
.water-stream { position: absolute; width: 200rpx; height: 92rpx; right: -30rpx; bottom: -25rpx; border: 17rpx solid #eef5ee; border-radius: 48% 80% 0 0; background: #7fb3c8; transform: rotate(18deg); }
.water-reed { position: absolute; width: 4rpx; height: 65rpx; left: 65rpx; top: 28rpx; background: #3a7d5c; transform: rotate(10deg); }
.water-leaf { position: absolute; width: 26rpx; height: 42rpx; left: 37rpx; top: 27rpx; border-radius: 80% 0 80% 0; background: #3a7d5c; transform: rotate(-62deg); }
.choose-water { margin: 28rpx 0 0; padding-left: 36rpx; padding-right: 36rpx; }
/* Only the widthFix image determines this container's height; captions live outside it. */
.image-wrap { position: relative; overflow: hidden; border-radius: 32rpx; line-height: 0; background: #e5efea; }
.preview { width: 100%; display: block; }
.box-layer { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.detection-box { position: absolute; border: 3rpx solid #e4a45f; }
.box-label { position: absolute; top: 0; left: 0; background: #e4a45f; color: #2c3e33; font-size: 21rpx; line-height: 1.4; padding: 0 6rpx; }
.water-picker { padding: 20rpx; margin-top: 20rpx; border-radius: 18rpx; background: #f0f4ed; font-size: 27rpx; }
.nearby { padding: 22rpx; border-radius: 22rpx; background: #eaf2e7; }
.privacy-link { color: #3a7d5c; margin-left: 10rpx; }
.result-banner { padding: 32rpx; background: linear-gradient(140deg, #e0ecd8, #e8f0ec); border-radius: 32rpx; }
.rule-score { font-size: 76rpx; line-height: 1.4; color: #3a7d5c; font-weight: 650; margin-top: 12rpx; }
.rule-score text { font-size: 25rpx; font-weight: 400; }
.detection-row { display: flex; gap: 16rpx; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #e5eddf; font-size: 26rpx; }
.detection-row .small { flex-shrink: 0; }
.ai-next { background: linear-gradient(135deg, #fdfefb, #e8f0e5); }
.ai-model { color: #3a7d5c; font-size: 22rpx; letter-spacing: .6rpx; }
.history-row { border-left: 5rpx solid #a8c99b; }
.observation-metrics { display: flex; text-align: center; }
.observation-metrics > view { flex: 1; padding: 18rpx 8rpx; }
.observation-number { color: #3a7d5c; font-size: 44rpx; font-weight: 600; }
.observation-grid { display: flex; flex-wrap: wrap; border-top: 1rpx solid #d8e3d1; border-left: 1rpx solid #d8e3d1; }
.observation-cell { box-sizing: border-box; width: 33.333333%; min-height: 110rpx; padding: 14rpx; border-right: 1rpx solid #d8e3d1; border-bottom: 1rpx solid #d8e3d1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #758575; font-size: 23rpx; }
.observation-cell-active { background: #eaf2e7; color: #3a7d5c; }
.observation-cell-count { font-size: 30rpx; margin-top: 8rpx; font-weight: 600; }
