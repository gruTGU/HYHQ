<view class="page ai-page {{session ? 'has-conversation' : ''}}">
  <view class="ai-heading"><view><text class="eyebrow">{{scopeLabel}} · 自然同行</text><view class="page-title">与山水对话</view></view><button class="history-button" bindtap="history" wx:if="{{loggedIn}}">对话记录</button></view>
  <view class="assistant-intro"><view class="assistant-avatar"><view class="avatar-leaf"></view></view><view class="grow"><view class="model-name">{{modelLabel}} <text class="model-badge">AI 助手</text></view><view class="small muted">从眼前的发现，聊到更远的知识。</view></view></view>
  <view wx:if="{{status && !status.enabled}}" class="notice"><view class="title">AI 暂未开放</view><view class="copy">当前不能发送新问题，已有对话仍可查看。</view></view>
  <page-state loading="{{loading}}" error="{{error}}" bindretry="load" />
  <view wx:if="{{!loading && !loggedIn}}" class="card section"><view class="title">登录，继续你的探索</view><view class="copy">登录后可开启对话，并在个人中心查看记录。</view><button class="primary gap" bindtap="login">去登录</button></view>
  <block wx:if="{{!loading && loggedIn && !unavailable}}">
    <view wx:if="{{source && !session}}" class="card section source-card welcome-source">
      <text class="pill">{{isRecognition ? '本次识别' : source.label}}</text><view class="title gap">{{isRecognition ? (source.result_view.heading || '查看原任务结果') : source.title}}</view>
      <view class="copy source-summary">{{isRecognition ? source.result_view.explanation : source.summary}}</view>
      <button class="text-button gap" bindtap="original">{{isRecognition ? '查看原识别结果' : '查看相关资料'}} ›</button>
      <view wx:if="{{isRecognition}}" class="image-choice"><view class="grow"><view class="title">附上原图，一起观察</view><view class="small muted gap">可选。开启后会将原图交给 DeepSeek 分析。</view></view><switch checked="{{includeImage}}" disabled="{{busy || !status.enabled}}" bindchange="imageChange" color="#3a7d5c" /></view>
      <button class="primary gap" loading="{{busy}}" disabled="{{busy || !status.enabled}}" bindtap="createSession">开启这段对话</button><view class="small muted centered gap">先开启对话，再写下你的问题。</view>
    </view>
    <block wx:if="{{session}}">
      <view class="context-card section"><view class="row context-toggle" bindtap="toggleContext"><view class="context-icon">↗</view><view class="grow"><text class="context-label">围绕这份资料</text><view class="context-title">{{session.is_recognition ? session.title : (source ? source.title : (sourceLoading ? '正在加载相关资料…' : '相关资料暂不可用'))}}</view></view><text class="context-expand">{{contextExpanded ? '收起 −' : '展开 +'}}</text></view><block wx:if="{{contextExpanded}}"><text wx:if="{{session.is_recognition || source}}" class="context-preview gap" selectable>{{session.is_recognition ? session.context_text : source.summary}}</text><button class="text-button gap" bindtap="original">{{session.is_recognition ? '查看原识别结果' : '查看相关资料'}} ›</button><view wx:if="{{session.is_recognition}}" class="small muted gap">{{session.include_image ? (session.image_available ? '已选择附图，发送时会检查原图是否有效。' : '原图已不可用，后续仅分享文字结果与对话。') : '仅分享文字结果与对话，不附送图片。'}}</view></block><view wx:if="{{sourceError}}" class="error-inline">{{sourceError}}<button class="text-button gap" bindtap="load" disabled="{{busy}}">重新加载资料</button></view></view>
      <view class="conversation-toolbar"><text class="small muted">你的自然问答</text><button class="text-button" bindtap="load" disabled="{{busy}}">刷新</button></view>
      <view wx:if="{{moreError}}" class="error-inline">{{moreError}}</view><button wx:if="{{next}}" class="text-button earlier-button" bindtap="more" loading="{{loadingMore}}" disabled="{{loadingMore || busy}}">加载更早的对话 ↑</button>
      <view class="chat-empty" wx:if="{{!turns.length && !moreError}}"><view class="empty-sprout"><view></view><view></view></view><view class="title">每个好奇，都值得聊聊</view><view class="copy">资料已准备好，在下方写下你的问题吧。</view></view>
      <view wx:for="{{displayTurns}}" wx:key="id" class="turn" id="turn-{{item.id}}">
        <view class="question-meta">我 · {{item.created_label}}</view><view class="question-bubble"><text class="question-text" selectable>{{item.question}}</text></view>
        <view class="answer-heading"><text class="answer-mark">✦</text><text class="answer-model">{{item.model_label}}</text><text class="answer-status">{{item.status_label}}</text></view>
        <view class="answer-bubble"><view wx:if="{{item.status === 'succeeded'}}" class="answer"><markdown-view content="{{item.answer || '本轮未提供可展示的文本。'}}" /></view><view wx:elif="{{item.status === 'failed'}}" class="answer-failed"><view class="title">这次回答未完成</view><view class="copy">{{item.message || '请稍后重新发送问题。'}}</view><button class="text-button gap" data-id="{{item.id}}" disabled="{{busy || hasPending || !status.enabled}}" bindtap="reuseQuestion">重新编辑问题</button></view><view wx:else class="answer-pending"><view class="thinking-leaf"></view><view><view class="title">正在整理答案</view><view class="small muted gap">可以稍后回来，对话会为你保留。</view></view></view><view wx:if="{{isRecognition}}" class="image-note">{{item.image_label}}</view></view>
      </view>
      <view wx:if="{{pollNotice}}" class="notice">{{pollNotice}}</view><button wx:if="{{polling}}" class="text-button polling-button" bindtap="pausePolling">暂停更新回答状态</button><button wx:elif="{{hasPending}}" class="secondary gap" bindtap="resumePolling" disabled="{{busy}}">继续获取回答</button>
    </block>
  </block>
  <view wx:if="{{actionError && !session}}" class="error-inline">{{actionError}}</view>
  <view class="ai-footnote">{{disclaimer}} <text class="privacy-link" bindtap="privacy">隐私说明</text></view>
  <view id="chat-latest" class="chat-anchor"></view>
  <view wx:if="{{session && loggedIn && !unavailable && !loading}}" class="composer-spacer" style="height: {{composerHeight + keyboardHeight}}px"></view>
  <view wx:if="{{session && loggedIn && !unavailable && !loading}}" class="composer {{keyboardHeight ? 'keyboard-open' : ''}}" style="bottom: {{keyboardHeight}}px"><view wx:if="{{actionError}}" class="composer-error">{{actionError}}</view><view class="composer-label"><text>{{!status ? '服务状态待确认，请刷新' : !status.enabled ? 'AI 暂未开放，可查看已有对话' : hasPending ? '等待这次回答，稍后继续聊' : '说说你的问题'}}</text><text>{{questionCount}} / 500</text></view><view class="composer-input"><textarea class="question" value="{{question}}" maxlength="500" auto-height adjust-position="{{false}}" show-confirm-bar="{{false}}" cursor-spacing="16" disabled="{{busy || hasPending || !status.enabled}}" bindinput="inputQuestion" bindkeyboardheightchange="keyboardHeightChanged" bindlinechange="composerLineChanged" bindblur="inputBlur" /><button class="primary send-button" loading="{{busy}}" disabled="{{busy || hasPending || !status.enabled || !questionCount}}" bindtap="send">{{busy ? '发送中' : '发送 ↑'}}</button></view><view class="composer-caption">{{hasPending ? '离开页面不会取消已发送的问题。' : 'AI 生成内容，请结合实际情况核对。'}}</view></view>
</view>
