.ai-page { padding-bottom: 36rpx; }
.ai-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.ai-page .history-button { width: auto; min-width: 0; margin: 0; padding: 13rpx 18rpx; border-radius: 99rpx; background: #e3eddd; color: #3a7d5c; font-size: 22rpx; line-height: 1.5; flex-shrink: 0; }
.history-button::after { border: 0; }
.model-name { color: #2c3e33; font-size: 27rpx; font-weight: 600; line-height: 1.8; }
.model-badge { color: #688665; font-size: 19rpx; font-weight: 400; margin-left: 8rpx; }
.image-choice { display: flex; align-items: center; gap: 20rpx; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #dce7d4; }
.image-choice switch { flex-shrink: 0; transform: scale(.85); transform-origin: right center; }
.context-card { border-radius: 26rpx; padding: 24rpx; background: #e7eee1; }
.context-toggle { align-items: center; gap: 16rpx; }
.context-icon { font-size: 28rpx; width: 45rpx; height: 45rpx; line-height: 45rpx; text-align: center; border-radius: 15rpx; background: #d4e3cb; color: #3a7d5c; flex-shrink: 0; }
.context-label { color: #7b8b72; font-size: 20rpx; }
.context-title { color: #2c3e33; font-size: 25rpx; line-height: 1.6; margin-top: 4rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.context-expand { flex-shrink: 0; color: #3a7d5c; font-size: 21rpx; }
.context-preview { display: block; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 25rpx; line-height: 1.8; color: #627467; max-height: 270rpx; overflow-y: auto; }
.conversation-toolbar { display: flex; justify-content: space-between; align-items: center; margin: 30rpx 0 16rpx; }
.turn { margin-top: 34rpx; }
.question-meta { font-size: 20rpx; color: #899281; text-align: right; margin-bottom: 10rpx; }
.question-bubble { margin-left: 58rpx; background: #dfead7; border-radius: 28rpx 8rpx 28rpx 28rpx; padding: 23rpx 26rpx; }
.question-text { display: block; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 28rpx; line-height: 1.8; color: #2c3e33; }
.answer-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; margin: 24rpx 0 12rpx; }
.answer-mark { color: #3a7d5c; font-size: 30rpx; }
.answer-model { color: #3a7d5c; font-size: 23rpx; font-weight: 600; }
.answer-status { color: #8c9789; font-size: 20rpx; margin-left: auto; }
.answer-bubble { background: #fffefa; padding: 26rpx; border-radius: 8rpx 28rpx 28rpx 28rpx; box-shadow: 0 5rpx 22rpx rgba(44,62,51,.035); border: 1rpx solid #e5ebdf; }
.answer-pending { display: flex; align-items: center; gap: 24rpx; padding: 12rpx 0; }
.thinking-leaf { flex-shrink: 0; width: 28rpx; height: 39rpx; background: #a8c99b; border-radius: 80% 0 80% 0; animation: leaf-think 1.5s ease-in-out infinite; }
@keyframes leaf-think { 0% { transform: rotate(0); opacity: .65; } 50% { opacity: 1; } 100% { transform: rotate(360deg); opacity: .65; } }
.answer-failed .title { color: #b66c47; }
.image-note { color: #86947f; font-size: 20rpx; line-height: 1.65; margin-top: 18rpx; }
.polling-button, .earlier-button { display: block; text-align: center; margin: 22rpx auto; font-size: 23rpx; }
.ai-footnote { color: #89937f; font-size: 21rpx; line-height: 1.7; margin-top: 30rpx; text-align: center; }
.privacy-link { color: #3a7d5c; white-space: nowrap; margin-left: 6rpx; }
.chat-anchor { height: 2rpx; }
.composer { position: fixed; z-index: 8; left: 0; right: 0; box-sizing: border-box; padding: 20rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: #f7faf3; border-top: 1rpx solid #dce7d4; box-shadow: 0 -8rpx 30rpx rgba(44,62,51,.035); }
.composer.keyboard-open { padding-bottom: 12rpx; }
.composer-label { display: flex; justify-content: space-between; align-items: center; color: #74836a; font-size: 21rpx; margin: 0 4rpx 12rpx; }
.composer-input { display: flex; align-items: flex-end; gap: 14rpx; padding: 14rpx 14rpx 14rpx 20rpx; border-radius: 24rpx; background: #fffefa; border: 1rpx solid #dce7d4; }
.question { flex: 1; width: 0; min-height: 60rpx; max-height: 180rpx; box-sizing: border-box; padding: 6rpx 0; font-size: 28rpx; line-height: 1.7; color: #2c3e33; }
.ai-page .send-button { width: auto; margin: 0; min-width: 124rpx; padding: 14rpx 20rpx; line-height: 1.6; font-size: 24rpx; border-radius: 18rpx; flex-shrink: 0; }
.composer-caption { color: #94a08c; font-size: 19rpx; text-align: center; line-height: 1.5; margin-top: 10rpx; }
.composer-error { max-height: 125rpx; overflow-y: auto; background: #fbefe5; color: #ac6543; border-radius: 16rpx; padding: 12rpx 18rpx; margin-bottom: 14rpx; font-size: 23rpx; line-height: 1.6; }

/* Long questions, source names, and provider errors must wrap inside the dock. */
.context-toggle .grow { min-width: 0; }
.composer-error, .context-title, .answer-failed .copy { overflow-wrap: anywhere; word-break: break-word; }
.composer-label { gap: 14rpx; align-items: flex-start; line-height: 1.6; }
.composer-label text:first-child { min-width: 0; flex: 1; }
.composer-label text:last-child { flex-shrink: 0; }

.weather-choice { border-top: 1rpx solid #dce5d8; padding-top: 16rpx; }.weather-selector { padding: 12rpx 16rpx; background: #f0f4ed; border-radius: 16rpx; font-size: 24rpx; }.citation-list { border-top: 1rpx solid #e2e9df; margin-top: 24rpx; padding-top: 20rpx; }.citation-button { text-align: left; white-space: normal; line-height: 1.6; margin-top: 12rpx; }
.composer-recovery { color: #99603f; font-size: 23rpx; line-height: 1.6; }
