.session-card { margin-top: 22rpx; }
.session-main { display: flex; align-items: center; gap: 20rpx; }
.session-symbol { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 62rpx; height: 72rpx; background: #e5eedf; color: #3a7d5c; border-radius: 70% 18% 65% 20%; font-size: 28rpx; }
.session-main .title { line-height: 1.6; }
.image-status { color: #7d8c77; font-size: 22rpx; margin-top: 20rpx; }
.session-footer { display: flex; gap: 12rpx; align-items: center; justify-content: space-between; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #e5ebdf; }
.delete-link { margin: 0; color: #b56b45; font-size: 23rpx; padding: 8rpx 0 8rpx 16rpx; flex-shrink: 0; }
