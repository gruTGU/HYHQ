<view style="{{themeStyle}}" class="page theme-{{themeId}} explore-page">

  <picker wx:if="{{regions.length}}" range="{{regions}}" range-key="name" value="{{regionIndex}}" bindchange="changeRegion" class="region-control">
    <view class="region-picker row" hover-class="pressable"><view><text class="small muted">当前城市 / 区域</text><view class="title">{{region.name}}</view></view><text class="chevron">⌄</text></view>
  </picker>
  <view wx:if="{{region.is_demo}}" class="notice">科普模拟体验 · 本区域的地点与河湖为虚构场景，可用于学习，不对应真实地理位置。</view>
  <view wx:if="{{!loading && !error && !region && mapNotice}}" class="notice">{{mapNotice}}</view>
  <scroll-view scroll-x class="filters section"><view class="filter {{activeType === item.value ? 'active' : ''}}" wx:for="{{types}}" wx:key="value" data-type="{{item.value}}" bindtap="chooseType" hover-class="pressable" aria-role="button">{{item.label}}</view></scroll-view>
  <view class="view-toolbar row" wx:if="{{!loading && !error && region}}"><view><block wx:if="{{useRealMap}}"><text class="place-count">{{filteredReferences.length}}</text><text class="small muted"> 个地图参考点</text><view wx:if="{{filtered.length}}" class="small muted">另有 {{filtered.length}} 处公开地点资料</view></block><block wx:else><text class="place-count">{{filtered.length}}</text><text class="small muted"> 处地点待探索</text></block></view><view class="view-tabs"><button class="{{viewMode === 'map' ? 'active' : ''}}" data-mode="map" bindtap="changeView" hover-class="pressable">{{useRealMap ? '真实地图' : '导览图'}}</button><button class="{{viewMode === 'list' ? 'active' : ''}}" data-mode="list" bindtap="changeView" hover-class="pressable">地点列表</button></view></view>
  <view wx:if="{{!loading && !error && useRealMap}}" hidden="{{viewMode !== 'map'}}" class="real-map-section">
    <picker wx:if="{{filteredReferences.length}}" range="{{referenceChoices}}" range-key="displayName" value="{{referenceIndex}}" bindchange="chooseReference"><view class="reference-picker" hover-class="pressable"><text class="reference-picker-label">{{referenceIndex ? referenceChoices[referenceIndex].displayName : '选择参考点，地图移至该处'}}</text><text class="reference-picker-arrow">⌄</text></view></picker>
    <map wx:for="{{realMapFrames}}" wx:for-item="frame" wx:key="generation" id="real-map-{{frame.generation}}" class="real-map" latitude="{{realLatitude}}" longitude="{{realLongitude}}" scale="{{realScale}}" subkey="{{mapSubkey}}" markers="{{realMarkers}}" polyline="{{realPolyline}}" show-location="{{false}}" enable-traffic="{{false}}" enable-zoom="{{true}}" enable-scroll="{{true}}" data-generation="{{frame.generation}}" bindmarkertap="selectRealPoint" bindcallouttap="selectRealPoint" bindlabeltap="selectRealPoint" binderror="realMapError" />
    <view class="real-map-controls"><button class="secondary" bindtap="locateMe" loading="{{locating}}" disabled="{{locating}}">定位到附近</button><button class="secondary" bindtap="resetCity">回到{{region.name}}</button></view>
    <view class="map-help">可直接拖动、缩放地图。仅点击“定位到附近”时获取一次附近模糊位置，拒绝后仍可浏览。</view>
    <view wx:if="{{referencePoints.length}}" class="map-help">本市已整理 {{referencePoints.length}} 个参考点，含部分郊区地点，可从上方选择器或地点列表找到。{{referenceScopeNote}}</view>
    <view wx:if="{{!places.length && !referencePoints.length && !placesError && !catalogLoading}}" class="notice">本市生态地点与河道资料正在整理审核，公开后将在此显示。现在可自由浏览真实地图。</view>
    <view wx:if="{{filtered.length && !realPointCount && !filteredReferences.length}}" class="notice">此分类的公开地点资料尚未附地图坐标，可先切换到地点列表阅读。</view>
    <view wx:if="{{realPointCount || realPolyline.length}}" class="map-help">{{realPolyline.length ? '蓝线仅表示已有核验资料的河段。' : '河道以已核验的观察点展示，暂不绘制未经核验的河道线。'}}底图上的其他地名由地图服务提供。</view>
    <view wx:if="{{riversError}}" class="notice">{{riversError}}</view>
    <view wx:if="{{selectedReference}}" class="card selected-card reference-card"><view class="reference-card-heading"><text class="pill">地图参考点</text><text class="small muted">{{selectedReference.sourceLabel}}</text></view><view class="title">{{selectedReference.name}}</view><view wx:if="{{selectedReference.displayName !== selectedReference.name}}" class="small muted gap">{{selectedReference.displayName}}</view><view wx:if="{{selectedReference.address}}" class="copy">{{selectedReference.address}}</view><view wx:if="{{selectedReference.access_note}}" class="small muted gap">{{selectedReference.access_note}}</view><view class="reference-card-note">{{referenceScopeNote}}目前不提供此参考点的入口导航。</view><view class="reference-card-source">资料日期 {{selectedReference.checked_at}} · {{selectedReference.source_note}}</view></view>
    <view wx:if="{{selectedPoint}}" class="card selected-card"><view class="row"><text class="selected-number">{{selectedPoint.order}}</text><view class="grow"><view class="title">{{selectedPoint.name}}</view><view class="copy">{{selectedPoint.description || selectedPoint.summary}}</view></view></view><view wx:if="{{selectedPoint.access_note}}" class="small muted gap">{{selectedPoint.access_note}}</view><view class="actions"><button class="secondary" data-id="{{selectedPoint.id}}" bindtap="open">查看地点详情</button><button class="primary" bindtap="navigatePoint">在地图中打开</button></view></view>
  </view>
  <view wx:if="{{!loading && !error && useRealMap && mapNotice}}" class="notice">{{mapNotice}}</view>
  <view wx:if="{{!loading && !error && useRealMap && locationNotice}}" class="notice">{{locationNotice}}</view>
  <view wx:if="{{!loading && !error && region && !useRealMap}}" hidden="{{viewMode !== 'map'}}" class="map-section">
    <view class="section-head"><text class="section-title">一张绿色导览图</text><text class="map-kind">静态示意图</text></view>
    <picker wx:if="{{maps.length > 1}}" range="{{maps}}" range-key="selectionLabel" value="{{mapIndex}}" bindchange="chooseMap"><view class="map-picker row" hover-class="pressable"><text>{{activeMap.selectionLabel}}</text><text>切换版本 ⌄</text></view></picker>
    <view class="map-frame" wx:for="{{imageFrames}}" wx:for-item="frame" wx:key="generation">
      <movable-area class="map-viewport" style="width: {{viewportWidth}}px; height: {{viewportHeight}}px;">
        <movable-view wx:for="{{viewportFrames}}" wx:for-item="viewport" wx:key="generation" class="map-content" direction="all" disabled="{{!imageReady || zoom === 1}}" x="{{panX}}" y="{{panY}}" inertia="{{false}}" out-of-bounds="{{false}}" animation="{{false}}" style="width: {{mapWidth}}px; height: {{mapHeight}}px;" data-generation="{{frame.generation}}" data-viewport="{{viewport.generation}}" bindchange="panMap">
          <image class="map-image" src="{{frame.src}}" mode="scaleToFill" style="width: {{mapWidth}}px; height: {{mapHeight}}px;" data-generation="{{frame.generation}}" data-viewport="{{viewport.generation}}" bindload="imageLoaded" binderror="imageFailed" />
          <block wx:if="{{imageReady}}"><view wx:for="{{markers}}" wx:key="id" class="map-marker marker-{{item.kind}} {{selectedPoint.id === item.id ? 'selected' : ''}}" style="left: {{item.left}}%; top: {{item.top}}%;" data-id="{{item.id}}" data-generation="{{frame.generation}}" data-viewport="{{viewport.generation}}" catchtap="selectPoint"><text>{{item.order}}</text></view></block>
        </movable-view>
      </movable-area>
      <view wx:if="{{!imageReady}}" class="map-loading">正在展开这片绿意…</view>
    </view>
    <view wx:if="{{mapNotice}}" class="notice">{{mapNotice}}</view>
    <view wx:if="{{mapImage}}" class="map-toolbar row"><text class="small muted">{{zoomLabel}} · 放大后可拖动</text><view class="zoom-buttons"><button hover-class="pressable" data-action="out" bindtap="zoomMap" disabled="{{!imageReady || zoom <= 1}}" aria-label="缩小导览图">−</button><button hover-class="pressable" data-action="in" bindtap="zoomMap" disabled="{{!imageReady || zoom >= 3}}" aria-label="放大导览图">＋</button><button hover-class="pressable" class="reset" data-action="reset" bindtap="zoomMap" disabled="{{!imageReady}}">复位</button></view></view>
    <view wx:if="{{imageReady}}" class="map-help">轻点编号查看地点，放大后可拖动。示意图不用于实际导航。</view>
    <view wx:if="{{selectedPoint && imageReady}}" class="card selected-card"><view class="row"><text class="selected-number">{{selectedPoint.order}}</text><view class="grow"><view class="title">{{selectedPoint.name}}</view><view class="copy">{{selectedPoint.description}}</view></view></view><button hover-class="pressable" class="primary gap" data-id="{{selectedPoint.id}}" bindtap="open">查看地点详情 ›</button></view>
    <view wx:if="{{activeMap}}" class="map-credit">{{activeMap.name}} · v{{activeMap.version}}<text wx:if="{{activeMap.attribution}}">{{activeMap.attribution}}</text></view>
  </view>
  <page-state loading="{{loading}}" error="{{error}}" empty="{{!loading && !catalogLoading && !error && !placesError && !filtered.length && !filteredReferences.length && (!useRealMap || viewMode === 'list')}}" empty-text="{{useRealMap ? '此分类暂无已整理的地点，可切换分类或继续浏览地图。' : '这类地点还在整理中，换个分类看看吧。'}}" bindretry="load" />
  <view wx:if="{{!loading && placesError}}" class="error-inline">地点列表暂不可用：{{placesError}}<button class="text-button gap" bindtap="load">重新加载</button></view>
  <view wx:if="{{!loading && !error}}" hidden="{{viewMode !== 'list'}}" class="location-list"><view wx:if="{{useRealMap && filteredReferences.length}}" class="reference-list-heading"><view class="title">地图参考点 · {{filteredReferences.length}}</view><view class="small muted">点选即可在地图中查看，包含市区及部分郊区地点。</view></view><view wx:for="{{filteredReferences}}" wx:key="id" class="card location-card reference-list-card" data-id="{{item.id}}" bindtap="openReference" hover-class="pressable" aria-role="button"><view class="row"><text class="location-number">{{item.order}}</text><view class="grow"><view class="title">{{item.name}}</view><view class="copy">{{item.address || item.displayName}}</view></view><text class="chevron">›</text></view><view class="location-meta"><text class="pill">{{item.sourceLabel}}</text><text class="small muted">在地图中查看参考点</text></view></view><view wx:if="{{useRealMap && filtered.length}}" class="reference-list-heading"><view class="title">公开地点资料 · {{filtered.length}}</view></view><view class="card location-card" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="open" hover-class="pressable" aria-role="button"><view class="row"><text class="location-number">{{item.order}}</text><view class="grow"><view class="title">{{item.name}}</view><view class="copy">{{item.summary || item.description || '查看地点资料与关联监测站'}}</view></view><text class="chevron">›</text></view><view class="location-meta"><text class="pill">{{item.is_demo ? '科普模拟地点' : '地点资料'}}</text><text class="small muted">{{useRealMap ? (item.canNavigate ? '已核验坐标' : '坐标待核验') : (activeMap && item.map_layout && item.map_layout === activeMap.id ? '图上已标注' : '地点目录')}}</text></view></view></view>
  <view class="explore-hint" wx:if="{{!loading && !error && viewMode === 'map' && !selectedPoint && !selectedReference && (filtered.length || filteredReferences.length)}}">{{useRealMap ? '点选地图标记查看地点，或切换地点列表。' : '点选图上的编号，或切换地点列表开始探索。'}}</view>
  <floating-ai visible="{{!loading && !error && region}}" tab-page="{{true}}" bindopen="openAI" />
</view>
