.page.theme-design-3 .profile-header { background: transparent; border-radius: 0; color: var(--hyhq-text); border-bottom: 1rpx solid var(--hyhq-accent); }
.page.theme-design-3 .profile-brand-mark { border: 1rpx solid var(--hyhq-border); border-radius: 4rpx; }
.page.theme-design-3 .profile-heading { font-family: 'Songti SC', 'STSong', serif; font-size: 38rpx; }
