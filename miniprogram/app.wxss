.page.theme-designed .source-link, .page.theme-designed .observation-toggle, .page.theme-designed .read-link, .page.theme-designed .article-category, .page.theme-designed .tags, .page.theme-designed .stop-count { color: var(--hyhq-primary); }
.page.theme-designed .pollutant, .page.theme-designed .scope-card, .page.theme-designed .scope-labels text { background: var(--hyhq-surface); color: var(--hyhq-text); border-radius: var(--hyhq-card-radius); }
.page.theme-designed .scope-card { border: 1rpx solid var(--hyhq-border); }
.page.theme-designed .scope-labels text { border: 1rpx solid var(--hyhq-border); }
.page.theme-designed .region-leaf { background: var(--hyhq-accent); }
.page.theme-designed .article-footer, .page.theme-designed .route-footer { border-color: var(--hyhq-border); }
