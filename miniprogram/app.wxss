.page.theme-designed .record-entry { color: var(--hyhq-text); }
.page.theme-designed .record-icon, .page.theme-designed .record-icon::before, .page.theme-designed .record-icon::after, .page.theme-designed .icon-water view { border-color: var(--hyhq-primary); color: var(--hyhq-primary); }
.page.theme-designed .icon-favorite::after, .page.theme-designed .icon-visit::after, .page.theme-designed .icon-chat::after { background: var(--hyhq-background); }
.page.theme-designed .model-name, .page.theme-designed .context-title, .page.theme-designed .question-text, .page.theme-designed .question { color: var(--hyhq-text); }
