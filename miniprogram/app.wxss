.page.theme-designed .record-date, .page.theme-designed .private-label, .page.theme-designed .feedback-time, .page.theme-designed .form-hint, .page.theme-designed .timestamp, .page.theme-designed .unit, .page.theme-designed .filter-hint, .page.theme-designed .source-summary { color: var(--hyhq-muted); }
.page.theme-designed .source-reference, .page.theme-designed .route-stop, .page.theme-designed .admin-row, .page.theme-designed .admin-cell { border-color: var(--hyhq-border); background: var(--hyhq-surface); border-radius: var(--hyhq-card-radius); }
