page { background: var(--hyhq-background, #f0f4ed); color: var(--hyhq-text, #2c3e33); font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 28rpx; line-height: 1.65; }
view, text, button, input, textarea { box-sizing: border-box; }
button { margin: 0; border-radius: var(--hyhq-button-radius, 24rpx); font-size: 28rpx; font-weight: 500; transition: transform 120ms ease, opacity 120ms ease; }
button::after { border: none; }
button[disabled] { opacity: .5; }
button:active, .button-hover, .pressable { transform: scale(.97); }
.page { background: var(--hyhq-background, #f0f4ed); color: var(--hyhq-text, #2c3e33); position: relative; z-index: 0; min-height: 100vh; max-width: 1000rpx; margin: 0 auto; padding: 32rpx 32rpx 192rpx; padding-bottom: calc(192rpx + env(safe-area-inset-bottom)); }
/* Leaf motifs belong to the whole page; fixed, noninteractive and behind content. */
.page::before, .page::after { content: ''; position: fixed; z-index: -1; pointer-events: none; border-radius: 85% 0 85% 0; }
.page::before { width: 340rpx; height: 480rpx; right: -150rpx; top: 12vh; background: var(--hyhq-leaf-primary, rgba(168, 201, 155, .16)); transform: rotate(28deg); }
.page::after { width: 280rpx; height: 390rpx; left: -165rpx; bottom: 12vh; background: var(--hyhq-leaf-secondary, rgba(127, 179, 200, .10)); transform: rotate(-32deg); }
.page-heading { font-size: 36rpx; font-weight: 600; line-height: 1.4; margin: 0 0 24rpx; }
.eyebrow { color: #587760; letter-spacing: 3rpx; font-size: 21rpx; font-weight: 600; }
.page-title { font-size: 48rpx; font-weight: 650; letter-spacing: -1rpx; line-height: 1.35; margin: 16rpx 0; }
.subtitle { color: var(--hyhq-muted, #65796c); font-size: 26rpx; line-height: 1.75; }
.section { margin-top: 32rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 18rpx; }
.section-title { font-size: 32rpx; font-weight: 600; }
.small { font-size: 23rpx; }
.muted { color: #697d6e; }
.card { background: var(--hyhq-surface, #fffefa); border: 1rpx solid rgba(58,125,92,.06); border-radius: var(--hyhq-card-radius, 32rpx); padding: 28rpx; box-shadow: 0 8rpx 30rpx rgba(44,62,51,.035); animation: card-arrive 300ms ease-out both; }
.card + .card { margin-top: 18rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.grow { flex: 1; min-width: 0; }
.gap { margin-top: 18rpx; }
.title { font-size: 30rpx; font-weight: 600; line-height: 1.6; }
.copy { color: var(--hyhq-muted, #65796c); font-size: 25rpx; line-height: 1.85; margin-top: 8rpx; }
.pill { display: inline-block; border-radius: 99rpx; padding: 5rpx 16rpx; background: #e8f0e3; color: #52735b; font-size: 22rpx; }
.notice { background: var(--hyhq-notice, #e7efdf); color: #546b4f; font-size: 23rpx; line-height: 1.85; border-radius: 24rpx; padding: 20rpx 24rpx; margin-top: 24rpx; }
.primary { background: var(--hyhq-primary, #3a7d5c); color: var(--hyhq-surface, #fffefa); padding: 8rpx 22rpx; min-height: 88rpx; }
.secondary { background: var(--hyhq-secondary, #e5efdf); color: var(--hyhq-secondary-text, #326849); padding: 8rpx 22rpx; min-height: 88rpx; }
.text-button { color: var(--hyhq-primary, #3a7d5c); background: transparent; padding: 12rpx 0; font-size: 25rpx; line-height: 1.8; min-height: 64rpx; }
.danger { background: #f8ebe2; color: #985b3e; }
.actions { display: flex; margin-top: 22rpx; }
.actions button { flex: 1; }
.actions button + button { margin-left: 16rpx; }
.divider { height: 1rpx; background: var(--hyhq-border, #e7eee1); margin: 24rpx 0; }
.field { margin-top: 22rpx; }
.field-label { display: block; font-size: 24rpx; color: var(--hyhq-muted, #65796c); margin-bottom: 12rpx; }
input { background: var(--hyhq-background, #f0f4ed); border-radius: 20rpx; padding: 20rpx; height: 88rpx; color: var(--hyhq-text, #2c3e33); }
textarea { color: var(--hyhq-text, #2c3e33); }
.error-inline { color: #995c3e; background: #faeee4; padding: 18rpx 22rpx; border-radius: 20rpx; font-size: 24rpx; margin-top: 18rpx; }
.chevron { font-size: 36rpx; color: #73917a; margin-left: 18rpx; }
.footer-note { color: #70816f; font-size: 21rpx; text-align: center; margin-top: 40rpx; letter-spacing: 2rpx; }
.metric-grid { display: flex; flex-wrap: wrap; margin: -8rpx; }
.metric { width: calc(50% - 16rpx); margin: 8rpx; padding: 24rpx; border-radius: 24rpx; background: var(--hyhq-surface, #fffefa); }
.metric-value { display: block; font-size: 42rpx; font-weight: 600; line-height: 1.5; }
.metric-label { font-size: 23rpx; color: var(--hyhq-muted, #65796c); }
@keyframes card-arrive { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .card { animation: none; } button { transition: none; } }

/* All appearances render the same page content. Images are optional decoration. */
.page.theme-designed { background-color: var(--hyhq-background); }
.page.theme-designed::before, .page.theme-designed::after { display: none; }
.page.theme-designed .title, .page.theme-designed .page-heading, .page.theme-designed .page-title, .page.theme-designed .section-title, .page.theme-designed .profile-name { font-family: 'Songti SC', 'STSong', 'Noto Serif CJK SC', serif; font-weight: 600; color: var(--hyhq-text); }
.page.theme-designed .card, .page.theme-designed .metric, .page.theme-designed .notice { border-radius: var(--hyhq-card-radius); border-color: var(--hyhq-border); box-shadow: none; }
.page.theme-designed .muted, .page.theme-designed .footer-note, .page.theme-designed .eyebrow, .page.theme-designed .chevron { color: var(--hyhq-muted); }
.page.theme-designed .pill { color: var(--hyhq-secondary-text); background: var(--hyhq-secondary); border: 1rpx solid var(--hyhq-border); }
.page.theme-designed .notice { background: var(--hyhq-notice); color: var(--hyhq-muted); }
.page.theme-designed input, .page.theme-designed textarea { border-radius: var(--hyhq-button-radius); }
.page.theme-designed .section-head { padding-bottom: 14rpx; border-bottom: 1rpx solid var(--hyhq-border); }
.page.theme-designed .primary, .page.theme-designed .secondary { border-radius: var(--hyhq-button-radius); }
.page.theme-designed .tabs, .page.theme-designed .observe-tabs, .page.theme-designed .view-tabs { border: 1rpx solid var(--hyhq-border); border-radius: var(--hyhq-button-radius); background: transparent; padding: 0; box-shadow: none; }
.page.theme-designed .tab, .page.theme-designed .observe-tab, .page.theme-designed .view-tabs button { color: var(--hyhq-muted); border-radius: 0; box-shadow: none; }
.page.theme-designed .tab.selected, .page.theme-designed .observe-tab.active, .page.theme-designed .view-tabs button.active { background: var(--hyhq-primary); color: var(--hyhq-surface); box-shadow: none; }
.page.theme-designed .region-picker, .page.theme-designed .reference-picker, .page.theme-designed .selector, .page.theme-designed .picker-value { border-color: var(--hyhq-border); border-radius: var(--hyhq-button-radius); background: var(--hyhq-surface); color: var(--hyhq-text); }
.page.theme-designed .filter, .page.theme-designed .map-picker { border-radius: var(--hyhq-button-radius); background: var(--hyhq-secondary); color: var(--hyhq-secondary-text); box-shadow: none; }
.page.theme-designed .filter.active { background: var(--hyhq-primary); color: var(--hyhq-surface); }
.page.theme-designed .reference-card-note, .page.theme-designed .reference-card-source, .page.theme-designed .map-kind, .page.theme-designed .map-help, .page.theme-designed .map-credit { color: var(--hyhq-muted); border-color: var(--hyhq-border); }
.page.theme-designed .map-frame, .page.theme-designed .real-map { border: 1rpx solid var(--hyhq-border); border-radius: var(--hyhq-card-radius); box-shadow: none; }
.page.theme-designed .selected-card, .page.theme-designed .location-card { background: var(--hyhq-surface); border-color: var(--hyhq-border); }
.page.theme-designed .place-count, .page.theme-designed .selected-number { color: var(--hyhq-primary); }
.page.theme-designed .location-number { background: var(--hyhq-secondary); color: var(--hyhq-secondary-text); border-radius: var(--hyhq-button-radius); }
.page.theme-designed .location-meta { border-color: var(--hyhq-border); }

/* Editorial: a compact photo index and ruled, unshadowed pages. */
.page.theme-design-2 { letter-spacing: .2rpx; }
.page.theme-design-2 .section-title { font-size: 34rpx; }
.page.theme-design-2 .article, .page.theme-design-2 .route-card { padding-left: 0; padding-right: 0; border-left: 0; border-right: 0; background: transparent; }
.page.theme-design-2 .article-title { font-size: 36rpx; line-height: 1.5; }
.page.theme-design-2 .article-index { font-size: 31rpx; font-family: Georgia, serif; }
