.page.theme-designed .route-card { background: var(--hyhq-surface); }
.page.theme-designed .profile-header::after { display: none; }
.page.theme-designed .profile-edit-link, .page.theme-designed .legal-link { color: var(--hyhq-primary); }
.page.theme-designed .avatar-frame { background: var(--hyhq-secondary); border-color: var(--hyhq-border); }
