.page.theme-design-3 .question-bubble { border-right: 3rpx solid var(--hyhq-primary); }

/* Existing weather, forms, lists and conversations keep their data/controls. */
.page.theme-designed .weather-card { border: 0; border-top: 1rpx solid var(--hyhq-border); border-bottom: 1rpx solid var(--hyhq-border); background: transparent; border-radius: 0; padding-left: 0; padding-right: 0; }
