# Copy to backend/.env for LOCAL development only. Environment variables override this file.
ENV=development
DJANGO_DEBUG=1
ALLOW_DEV_AUTH=1
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_URL=postgresql://hyhq:hyhq-dev-only@127.0.0.1:5432/hyhq
# Explicit development fallback; PostgreSQL remains the primary database.
HYHQ_USE_SQLITE=0
WECHAT_APP_ID=
WECHAT_APP_SECRET=
TRUST_PROXY_HTTPS=0
# M3: default model root is <repository>/inference/artifacts (server-local files).
# HYHQ_MODEL_ROOT=/absolute/path/to/inference/artifacts
HYHQ_RECOGNITION_TIMEOUT_SECONDS=10
# River visual observation model; defaults to the same trusted artifact directory.
# HYHQ_ASSESSMENT_MODEL_ROOT=/absolute/path/to/inference/artifacts
HYHQ_ASSESSMENT_TIMEOUT_SECONDS=10
# L01: optional external AI. Also enable its configuration in Django Admin.
# Store a real key only in the local ignored .env or a server environment file.
LLM_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
LLM_DAILY_TURN_LIMIT=5
# Weather: split one account's budget between deployments; local 100 + server 29900.
# API Host is the dedicated hostname from QWeather console, without https://.
QWEATHER_ENABLED=0
QWEATHER_API_HOST=
QWEATHER_API_KEY=
QWEATHER_MONTHLY_LIMIT=100
QWEATHER_WEATHER_TTL_SECONDS=1800
QWEATHER_AIR_TTL_SECONDS=3600
QWEATHER_ALERT_TTL_SECONDS=900

# Optional features: retain 0 until the documented external prerequisites pass.
COMMUNITY_ENABLED=0
QWEATHER_FORECAST_ENABLED=0
QWEATHER_FORECAST_ENTITLEMENT_CONFIRMED=0
QWEATHER_FORECAST_TTL_SECONDS=21600
WEATHER_SUBSCRIPTIONS_ENABLED=0
WEATHER_SUBSCRIPTIONS_CAPABILITY_CONFIRMED=0
WEATHER_SUBSCRIPTION_TEMPLATE_ID=
WEATHER_SUBSCRIPTION_FIELDS={}
